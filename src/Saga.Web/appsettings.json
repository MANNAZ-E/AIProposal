{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Saga": ""
  },
  "Auth": {
    "DevAutoSignIn": false
  },
  // No client credential of any kind, by design. Saga only signs users in — it never calls a
  // downstream API on the user's behalf, so Program.cs stops at AddMicrosoftIdentityWebApp and the
  // flow resolves to response_type=id_token / form_post: the ID token comes back on the front
  // channel and the token endpoint is never reached, so there is nothing to authenticate the client
  // with. Adding .EnableTokenAcquisitionToCallDownstreamApi() would flip this to the code flow and
  // require one — reach for a federated credential on the App Service managed identity then, not a
  // secret. The app registration needs "ID tokens" ticked under implicit/hybrid flows, and a
  // /signin-oidc redirect URI per environment (localhost included, for real sign-in in dev).
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "6443a88d-b20d-4c72-8654-f76c5e407909",
    "ClientId": "eca5258b-7242-41cc-8416-ef5d8d8d9696",
    "CallbackPath": "/signin-oidc"
  },
  // Both flags force the offline stand-ins even when the endpoints below are configured, so the
  // UI can be exercised without spending anything. Read once at startup — a change needs a restart.
  "Ai": {
    "UseFakeAi": false,
    "UseFakeExtractor": false
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "Key": "",
    // Both tiers run on Luna for now; Terra stays deployed and priced below, so switching the
    // Strong tier back is this one value.
    "StrongDeployment": "gpt-5.6-luna",
    "LightDeployment": "gpt-5.6-luna",
    "ContextTokenBudget": 100000
  },
  "ContentUnderstanding": {
    "Endpoint": ""
  },
  "Pricing": {
    "UsdToDkk": 0,
    "CapturePayloads": true,
    // USD per 1M tokens, keyed by DEPLOYMENT name (what the stream reports back) — adding a model
    // means adding a key here, not changing code. Short-context tier: the working context is
    // capped at AzureOpenAI:ContextTokenBudget, so calls stay below the long-context threshold.
    // Rates as published for GPT-5.6, checked 2026-08-24. Re-check before trusting the totals.
    "Models": {
      "gpt-5.6-terra": { "InputPer1M": 4.40, "CachedInputPer1M": 0.44, "OutputPer1M": 26.40 },
      "gpt-5.6-luna": { "InputPer1M": 1.10, "CachedInputPer1M": 0.11, "OutputPer1M": 6.60 }
    },
    // USD per 1,000 units, from Microsoft's retail price feed for West Europe (checked
    // 2026-08-24). Keyed by METER, not by analyzer: Content Understanding charges for the work it
    // actually performed, so prebuilt-layout bills Minimal on a digital Office file and Standard on
    // a PDF, an image, or a screenshot lifted out of a .docx — a 500x difference on the same call.
    "ContentUnderstanding": {
      "DocumentPagesMinimalPer1000": 0.01,
      "DocumentPagesBasicPer1000": 1.00,
      "DocumentPagesStandardPer1000": 5.00,
      // Pure content extraction produces none; only a generative analyzer would.
      "ContextualizationTokensPer1000": 0.001
    }
  },
  "Storage": {
    "LocalPath": ""
  }
}
