@page "/admin"
@using Saga.Core.Abstractions
@using Saga.Web.Auth
@inject AdminService Admin
@inject ProposalService Proposals
@inject AiUsageService Usage
@inject ImpersonationAuditService ImpersonationAudit
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Saga — Admin</PageTitle>

@if (_ready)
{
    <h1 class="page-heading">Admin</h1>

    <div class="section-title" style="margin-top: 1rem;">Mannaz voice</div>
    <div class="card" style="max-width: 760px;">
        <div class="form-field">
            <label for="voice-tone">Tone of voice</label>
            <textarea id="voice-tone" rows="4" @bind="_tone"
                      placeholder="e.g. Confident but not salesy. Concrete and specific. Short sentences. No filler, no hype."></textarea>
        </div>
        <div class="form-field">
            <label for="voice-about">About Mannaz</label>
            <textarea id="voice-about" rows="5" @bind="_about"
                      placeholder="Who Mannaz is, history, size, signature strengths, typical clients…"></textarea>
        </div>
        <div class="form-field">
            <label for="voice-terms">Terminology and methods</label>
            <textarea id="voice-terms" rows="4" @bind="_terminology"
                      placeholder="Preferred terms and method names — and words to avoid."></textarea>
        </div>
        <div class="modal-actions" style="justify-content: flex-start;">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">Save voice settings</button>
            @if (_saved)
            {
                <span class="badge badge-ok">Saved</span>
            }
        </div>
    </div>

    <div class="section-title">Recycle bin</div>
    @if (_deleted.Count == 0)
    {
        <div class="empty-state"><p>No deleted proposals.</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Proposal</th>
                    <th>Client</th>
                    <th>Owner</th>
                    <th>Deleted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _deleted)
                {
                    <tr>
                        <td><strong>@row.Title</strong></td>
                        <td>@row.ClientName</td>
                        <td>@row.OwnerName</td>
                        <td class="text-muted">@(row.DeletedAt?.LocalDateTime.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td style="text-align: right;">
                            <button class="btn btn-outline btn-sm" @onclick="() => RestoreProposalAsync(row.ProposalId)"
                                    disabled="@_restoring">Restore</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="section-title">Users</div>
    <div class="card">
        <div class="team-add-row">
            <div class="form-field" style="flex: 2; min-width: 220px; margin-bottom: 0;">
                <label for="user-email">Email</label>
                <input id="user-email" type="email" @bind="_newEmail" placeholder="name@mannaz.com" />
            </div>
            <div class="form-field" style="flex: 2; min-width: 220px; margin-bottom: 0;">
                <label for="user-name">Name</label>
                <input id="user-name" type="text" @bind="_newName" />
            </div>
            <button class="btn btn-primary" @onclick="AddUserAsync" disabled="@_userBusy">Add</button>
        </div>
        @if (_userError is not null)
        {
            <p class="error-text" style="margin-bottom: 0;">@_userError</p>
        }
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Name</th>
                <th>Admin</th>
                <th>Status</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _users)
            {
                var isSelf = row.Id == _currentUserId;
                <tr>
                    <td>@row.Email</td>
                    <td>
                        @if (_editingUserId == row.Id)
                        {
                            <input type="text" @bind="_editName" />
                        }
                        else
                        {
                            @row.DisplayName
                        }
                    </td>
                    <td>
                        @if (row.IsAdmin)
                        {
                            <span class="badge badge-ok">Admin</span>
                        }
                    </td>
                    <td>
                        @if (row.IsDeleted)
                        {
                            <span class="badge badge-missing">Deleted</span>
                        }
                        else
                        {
                            <span class="badge badge-ok">Active</span>
                        }
                    </td>
                    <td class="text-muted">@row.CreatedAt.LocalDateTime.ToString("dd MMM yyyy")</td>
                    <td style="text-align: right;">
                        @if (row.IsDeleted)
                        {
                            <button class="btn btn-outline btn-sm" @onclick="() => RestoreUserAsync(row.Id)" disabled="@_userBusy">Restore</button>
                        }
                        else if (_editingUserId == row.Id)
                        {
                            <button class="btn btn-outline btn-sm" @onclick="SaveEditAsync" disabled="@_userBusy">Save</button>
                            <button class="btn btn-outline btn-sm" @onclick="CancelEdit">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-outline btn-sm" @onclick="() => StartEdit(row)">Edit</button>
                            @if (!isSelf)
                            {
                                @if (row.IsAdmin)
                                {
                                    <button class="btn btn-outline btn-sm" @onclick="() => SetAdminAsync(row.Id, false)" disabled="@_userBusy">Revoke admin</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline btn-sm" @onclick="() => SetAdminAsync(row.Id, true)" disabled="@_userBusy">Make admin</button>
                                }
                                <button class="btn btn-outline btn-sm" @onclick="() => OpenRemove(row)" disabled="@_userBusy">Remove</button>
                                <button class="btn btn-outline btn-sm" @onclick="() => ImpersonateAsync(row.Id)"
                                        disabled="@(_userBusy || CurrentUser.IsImpersonating)">Impersonate</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_impersonateError is not null)
    {
        <p class="error-text">@_impersonateError</p>
    }

    <div class="section-title">Impersonation sessions</div>
    @if (_sessions.Count == 0)
    {
        <div class="empty-state"><p>No impersonation sessions recorded yet.</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Admin</th>
                    <th>Viewing as</th>
                    <th>Started</th>
                    <th>Ended</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _sessions)
                {
                    <tr>
                        <td>@row.AdminName</td>
                        <td>@row.TargetName</td>
                        <td class="text-muted">@row.StartedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-muted">@(row.EndedAt?.LocalDateTime.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td class="text-muted">@ReasonText(row.EndReason)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="section-title">Usage by service</div>
    @if (_breakdown.Count == 0)
    {
        <div class="empty-state"><p>No AI calls recorded yet.</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Model</th>
                    <th style="text-align: right;">Calls</th>
                    <th style="text-align: right;">Tokens in</th>
                    <th style="text-align: right;">Cached in</th>
                    <th style="text-align: right;">Tokens out</th>
                    <th style="text-align: right;">Pages</th>
                    <th style="text-align: right;">Est. cost (@Money.Currency(_rate))</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in _breakdown.GroupBy(b => b.Service))
                {
                    var groupTotal = AiUsageService.Sum(group.Select(g => g.Totals));
                    <tr class="table-group">
                        <td colspan="2"><strong>@ServiceName(group.Key)</strong></td>
                        <td style="text-align: right;">@groupTotal.Calls.ToString("N0")</td>
                        <td style="text-align: right;">@groupTotal.InputTokens.ToString("N0")</td>
                        <td style="text-align: right;">@Tokens.Cached(groupTotal.CachedInputTokens, groupTotal.InputTokens)</td>
                        <td style="text-align: right;">@groupTotal.OutputTokens.ToString("N0")</td>
                        <td style="text-align: right;">@(groupTotal.Pages > 0 ? groupTotal.Pages.ToString("N0") : "—")</td>
                        <td style="text-align: right;"><strong>@Cost(groupTotal.CostUsd)</strong></td>
                    </tr>
                    @foreach (var row in group)
                    {
                        <tr>
                            <td></td>
                            <td>@row.Model</td>
                            <td style="text-align: right;">@row.Totals.Calls.ToString("N0")</td>
                            <td style="text-align: right;">@row.Totals.InputTokens.ToString("N0")</td>
                            <td style="text-align: right;">@Tokens.Cached(row.Totals.CachedInputTokens, row.Totals.InputTokens)</td>
                            <td style="text-align: right;">@row.Totals.OutputTokens.ToString("N0")</td>
                            <td style="text-align: right;">@(row.Totals.Pages > 0 ? row.Totals.Pages.ToString("N0") : "—")</td>
                            <td style="text-align: right;">@Cost(row.Totals.CostUsd)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }

    <div class="section-title">Usage by proposal</div>
    @if (_usage.Count == 0)
    {
        <div class="empty-state"><p>No AI calls recorded yet.</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Proposal</th>
                    <th>Client</th>
                    <th style="text-align: right;">Calls</th>
                    <th style="text-align: right;">Tokens in</th>
                    <th style="text-align: right;">Cached in</th>
                    <th style="text-align: right;">Tokens out</th>
                    <th style="text-align: right;">Pages</th>
                    <th style="text-align: right;">Est. cost (@Money.Currency(_rate))</th>
                    <th>Last activity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _usage)
                {
                    <tr>
                        <td><a href="/proposals/@row.ProposalId">@row.Title</a></td>
                        <td>@row.ClientName</td>
                        <td style="text-align: right;">@row.Calls.ToString("N0")</td>
                        <td style="text-align: right;">@row.InputTokens.ToString("N0")</td>
                        <td style="text-align: right;">@Tokens.Cached(row.CachedInputTokens, row.InputTokens)</td>
                        <td style="text-align: right;">@row.OutputTokens.ToString("N0")</td>
                        <td style="text-align: right;">@(row.Pages > 0 ? row.Pages.ToString("N0") : "—")</td>
                        <td style="text-align: right;">@Cost(row.CostUsd)</td>
                        <td>@row.LastCallAt?.ToLocalTime().ToString("dd MMM HH:mm")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Total</th>
                    <th></th>
                    <th style="text-align: right;">@_usage.Sum(u => u.Calls).ToString("N0")</th>
                    <th style="text-align: right;">@_usage.Sum(u => u.InputTokens).ToString("N0")</th>
                    <th style="text-align: right;">@Tokens.Cached(_usage.Sum(u => u.CachedInputTokens), _usage.Sum(u => u.InputTokens))</th>
                    <th style="text-align: right;">@_usage.Sum(u => u.OutputTokens).ToString("N0")</th>
                    <th style="text-align: right;">@_usage.Sum(u => u.Pages).ToString("N0")</th>
                    <th style="text-align: right;">@Cost(_usage.Sum(u => u.CostUsd))</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    }

    @if (_removeTarget is not null)
    {
        <div class="modal-backdrop" @onclick="CloseRemove">
            <div class="modal-panel" @onclick:stopPropagation>
                <h2 class="modal-title">Remove user</h2>
                <p>Remove <strong>@_removeTarget.DisplayName</strong>? They will no longer be able to sign in, but everything of theirs stays and can be restored here.</p>
                <div class="modal-actions">
                    <button class="btn btn-danger" @onclick="RemoveUserAsync" disabled="@_userBusy">Remove</button>
                    <button class="btn btn-outline" @onclick="CloseRemove">Cancel</button>
                </div>
            </div>
        </div>
    }
}
else
{
    <p class="text-muted">Loading…</p>
}

@code {
    private bool _ready;
    private Guid _currentUserId;

    private string _tone = "";
    private string _about = "";
    private string _terminology = "";
    private bool _saving;
    private bool _saved;
    private bool _restoring;
    private List<ProposalSpend> _usage = [];
    private List<AiUsageBreakdownRow> _breakdown = [];
    private List<DeletedProposal> _deleted = [];
    private decimal _rate;

    private List<AdminUserRow> _users = [];
    private string _newEmail = "";
    private string _newName = "";
    private string? _userError;
    private bool _userBusy;
    private Guid? _editingUserId;
    private string _editName = "";
    private AdminUserRow? _removeTarget;
    private string? _impersonateError;
    private List<ImpersonationSessionRow> _sessions = [];

    protected override async Task OnInitializedAsync()
    {
        var me = await CurrentUser.GetAsync();
        if (!me.IsAdmin)
        {
            Nav.NavigateTo("/");
            return;
        }
        _currentUserId = me.Id;

        var voice = await Admin.GetVoiceAsync();
        (_tone, _about, _terminology) = (voice.ToneOfVoice, voice.AboutMannaz, voice.Terminology);
        _rate = Usage.UsdToDkk;
        _usage = await Admin.GetUsageAsync();
        _breakdown = await Usage.GetGlobalBreakdownAsync();
        _deleted = await Admin.GetDeletedProposalsAsync();
        _users = await Admin.ListUsersAsync();
        _sessions = await ImpersonationAudit.GetAllAsync();
        _ready = true;
    }

    private string Cost(decimal usd) => Money.Display(usd, _rate);

    private static string ServiceName(AiServiceKind service) => service switch
    {
        AiServiceKind.AzureOpenAI => "Azure OpenAI",
        AiServiceKind.ContentUnderstanding => "Azure Content Understanding",
        _ => service.ToString(),
    };

    private static string ReasonText(ImpersonationEndReason? reason) => reason switch
    {
        ImpersonationEndReason.StoppedByAdmin => "Stopped",
        ImpersonationEndReason.CircuitDisconnected => "Disconnected",
        _ => "—",
    };

    private async Task RestoreProposalAsync(Guid proposalId)
    {
        _restoring = true;
        try
        {
            await Proposals.RestoreAsAdminAsync(proposalId);
            _deleted = await Admin.GetDeletedProposalsAsync();
        }
        finally
        {
            _restoring = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        try
        {
            await Admin.SaveVoiceAsync(_tone, _about, _terminology);
            _saved = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AddUserAsync()
    {
        _userBusy = true;
        _userError = null;
        try
        {
            await Admin.AddUserAsync(_currentUserId, _newEmail, _newName);
            _newEmail = "";
            _newName = "";
            _users = await Admin.ListUsersAsync();
        }
        catch (Exception ex)
        {
            _userError = ex.Message;
        }
        finally
        {
            _userBusy = false;
        }
    }

    private void StartEdit(AdminUserRow row)
    {
        _editingUserId = row.Id;
        _editName = row.DisplayName;
    }

    private void CancelEdit() => _editingUserId = null;

    private async Task SaveEditAsync()
    {
        if (_editingUserId is not { } id) return;
        _userBusy = true;
        try
        {
            await Admin.UpdateUserAsync(_currentUserId, id, _editName);
            _editingUserId = null;
            _users = await Admin.ListUsersAsync();
        }
        finally
        {
            _userBusy = false;
        }
    }

    private async Task SetAdminAsync(Guid userId, bool isAdmin)
    {
        _userBusy = true;
        _userError = null;
        try
        {
            await Admin.SetAdminAsync(_currentUserId, userId, isAdmin);
            _users = await Admin.ListUsersAsync();
        }
        catch (Exception ex)
        {
            _userError = ex.Message;
        }
        finally
        {
            _userBusy = false;
        }
    }

    private void OpenRemove(AdminUserRow row) => _removeTarget = row;

    private void CloseRemove() => _removeTarget = null;

    private async Task RemoveUserAsync()
    {
        if (_removeTarget is null) return;
        _userBusy = true;
        _userError = null;
        try
        {
            await Admin.DeleteUserAsync(_currentUserId, _removeTarget.Id);
            _removeTarget = null;
            _users = await Admin.ListUsersAsync();
        }
        catch (Exception ex)
        {
            _userError = ex.Message;
        }
        finally
        {
            _userBusy = false;
        }
    }

    private async Task RestoreUserAsync(Guid userId)
    {
        _userBusy = true;
        try
        {
            await Admin.RestoreUserAsync(_currentUserId, userId);
            _users = await Admin.ListUsersAsync();
        }
        finally
        {
            _userBusy = false;
        }
    }

    private async Task ImpersonateAsync(Guid userId)
    {
        _impersonateError = null;
        try
        {
            await CurrentUser.StartImpersonationAsync(userId);
            // A full reload, not Nav.Refresh: AppBar and the impersonation banner each run on
            // their own circuit (their common ancestor, MainLayout, isn't itself interactive),
            // so only a fresh page load has every one of them re-resolve the effective user.
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _impersonateError = ex.Message;
        }
    }
}
