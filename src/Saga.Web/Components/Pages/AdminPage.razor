@page "/admin"
@page "/admin/{SectionSlug}"
@implements IDisposable
@using Saga.Web.Auth
@inject CurrentUserService CurrentUser
@inject AppHeaderState Header
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Saga — Admin</PageTitle>

@if (_ready)
{
    <div class="workspace">
        <nav class="workspace-nav">
            @foreach (var (section, label) in Sections)
            {
                <a class="nav-item @(_section == section ? "active" : null)" href="/admin/@Slug(section)">@label</a>
            }
        </nav>

        <div class="workspace-main">
            <div class="workspace-content">
                @if (_section == Section.Users)
                {
                    <AdminUsersSection />
                }
                else if (_section == Section.Prompts)
                {
                    <AdminPromptsSection />
                }
                else if (_section == Section.Usage)
                {
                    <AdminUsageSection />
                }
                else if (_section == Section.RecycleBin)
                {
                    <AdminRecycleBinSection />
                }
            </div>
        </div>
    </div>
}
else
{
    <p class="text-muted">Loading…</p>
}

@code {
    [Parameter] public string? SectionSlug { get; set; }

    private enum Section { Users, Prompts, Usage, RecycleBin }

    /// <summary>The left menu, in the order it is drawn.</summary>
    private static readonly (Section Section, string Label)[] Sections =
    [
        (Section.Users, "Users"),
        (Section.Prompts, "System prompts"),
        (Section.Usage, "Usage"),
        (Section.RecycleBin, "Recycling bin"),
    ];

    private static string Slug(Section section) => section switch
    {
        Section.Prompts => "prompts",
        Section.Usage => "usage",
        Section.RecycleBin => "recycle-bin",
        _ => "users",
    };

    private static Section? Parse(string? slug) => slug?.ToLowerInvariant() switch
    {
        "users" => Section.Users,
        "prompts" => Section.Prompts,
        "usage" => Section.Usage,
        "recycle-bin" => Section.RecycleBin,
        _ => null,
    };

    private bool _ready;
    private Section _section = Section.Users;

    protected override async Task OnInitializedAsync()
    {
        var me = await CurrentUser.GetAsync();
        if (!me.IsAdmin)
        {
            Nav.NavigateTo("/");
            return;
        }
        Header.Set("Admin", null, null);
        _ready = true;
    }

    protected override void OnParametersSet()
    {
        // Bare /admin, or a slug nobody recognises, becomes /admin/users — the menu should never
        // render with nothing highlighted, and the URL should say which section you are looking at.
        if (Parse(SectionSlug) is not { } section)
        {
            Nav.NavigateTo("/admin/users", replace: true);
            return;
        }
        _section = section;
    }

    public void Dispose() => Header.Clear();
}
