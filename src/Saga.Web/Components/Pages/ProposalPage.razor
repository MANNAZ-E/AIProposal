@page "/proposals/{ProposalId:guid}"
@page "/proposals/{ProposalId:guid}/{SectionSlug}"
@page "/proposals/{ProposalId:guid}/{SectionSlug}/{SubId}"
@using Section = Saga.Web.Components.Proposal.ProposalSection
@implements IDisposable
@inject ProposalService Proposals
@inject ArtifactService Artifacts
@inject ChatService Chat
@inject TeamChatService TeamChat
@inject TeamChatNotifier TeamChatNotifier
@inject CurrentUserService CurrentUser
@inject AppHeaderState Header
@inject NavigationManager Nav
@inject AiUsageService Usage
@inject AiUsageNotifier AiUsageNotifier

<PageTitle>Saga – @(_proposal?.Title ?? "Proposal")</PageTitle>

@if (_notFound)
{
    <div class="empty-state">
        <p>This proposal does not exist, or you do not have access to it.</p>
        <a class="btn btn-outline" href="/">Back to proposals</a>
    </div>
}
else if (_proposal is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="workspace">
        <nav class="workspace-nav">
            <a class="nav-item @(_section == Section.Material ? "active" : null)"
               href="@Href(Section.Material)">Materials</a>
            <div class="nav-divider"></div>
            <a class="nav-item @(_section == Section.Chat ? "active" : null)"
               href="@Href(Section.Chat)">AI Chat @ChatBadge()</a>
            <a class="nav-item @(_section == Section.BidTeamChat ? "active" : null)"
               href="@Href(Section.BidTeamChat)">Team Chat @TeamBadge()</a>
            <div class="nav-divider"></div>
            <a class="nav-item @(_section == Section.Generate ? "active" : null)"
               href="@Href(Section.Generate)">Generate</a>
            <a class="nav-item @(_section == Section.ClientProfile ? "active" : null) @ArtifactPendingClass(ArtifactType.ClientProfile)"
               href="@Href(Section.ClientProfile)">Client profile @ArtifactBadge(ArtifactType.ClientProfile)</a>
            <a class="nav-item @(_section == Section.Summary ? "active" : null) @ArtifactPendingClass(ArtifactType.Summary)"
               href="@Href(Section.Summary)">Summary @ArtifactBadge(ArtifactType.Summary)</a>
            <a class="nav-item @(_section == Section.Requirements ? "active" : null) @ArtifactPendingClass(ArtifactType.Requirements)"
               href="@Href(Section.Requirements)">Requirements @ArtifactBadge(ArtifactType.Requirements)</a>
            <a class="nav-item @(_section == Section.Scoping ? "active" : null) @ArtifactPendingClass(ArtifactType.Scoping)"
               href="@Href(Section.Scoping)">Scoping @ArtifactBadge(ArtifactType.Scoping)</a>
            <a class="nav-item @(_section == Section.SolutionProposal ? "active" : null) @ArtifactPendingClass(ArtifactType.SolutionProposal)"
               href="@Href(Section.SolutionProposal)">Solution @ArtifactBadge(ArtifactType.SolutionProposal)</a>
            <div class="nav-divider"></div>
            <a class="nav-item @(_section == Section.Structure ? "active" : null) @ArtifactPendingClass(ArtifactType.Structure)"
               href="@Href(Section.Structure)">Structure @ArtifactBadge(ArtifactType.Structure)</a>
            <a class="nav-item @(_section == Section.Content ? "active" : null) @ArtifactPendingClass(ArtifactType.Content)"
               href="@Href(Section.Content)">Content @ArtifactBadge(ArtifactType.Content)</a>
            <div class="nav-divider"></div>
            <a class="nav-item @(_section == Section.Export ? "active" : null)"
               href="@Href(Section.Export)">Export</a>
            <div class="nav-divider"></div>
            <a class="nav-item @(_section == Section.Review ? "active" : null)"
               href="@Href(Section.Review)">Review</a>
            <div class="nav-divider"></div>
            <a class="nav-item @(_section == Section.Usage ? "active" : null)"
               href="@Href(Section.Usage)">Usage</a>
            <a class="nav-item @(_section == Section.People ? "active" : null)"
               href="@Href(Section.People)">Team</a>
            <a class="nav-item @(_section == Section.Settings ? "active" : null)"
               href="@Href(Section.Settings)">Settings</a>
        </nav>

        <div class="workspace-main @(_section is Section.Chat or Section.BidTeamChat ? "flush" : null)">
            <div class="workspace-content">
                @if (_section == Section.Material)
                {
                    <MaterialSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor" />
                }
                else if (_section == Section.Generate)
                {
                    <GenerateSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor"
                                     OnChanged="LoadAsync" />
                }
                else if (_section == Section.Summary)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.Summary" Title="Summary"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Requirements)
                {
                    <RequirementsSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor"
                                         OnChanged="LoadAsync" />
                }
                else if (_section == Section.ClientProfile)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.ClientProfile" Title="Client profile"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Scoping)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.Scoping" Title="Scoping"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.SolutionProposal)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.SolutionProposal" Title="Solution"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Structure)
                {
                    <StructureSection ProposalId="ProposalId" OutputFormat="_proposal.OutputFormat"
                                      CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Content)
                {
                    <ContentSection ProposalId="ProposalId" OutputFormat="_proposal.OutputFormat"
                                    CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Review)
                {
                    <ReviewSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor" />
                }
                else if (_section == Section.Chat)
                {
                    <ChatSection ProposalId="ProposalId" MyRole="_myRole" SubId="@SubId"
                                 TeammateCount="_proposal.Members.Count - 1"
                                 OnUnreadChanged="RefreshUnreadAsync"
                                 OnAddMaterials="GoToMaterials" />
                }
                else if (_section == Section.BidTeamChat)
                {
                    <BidTeamChatSection ProposalId="ProposalId" SubId="@SubId"
                                        OnUnreadChanged="RefreshTeamUnreadAsync" />
                }
                else if (_section == Section.Export)
                {
                    <ExportSection ProposalId="ProposalId" />
                }
                else if (_section == Section.Usage)
                {
                    <UsageSection ProposalId="ProposalId" />
                }
                else if (_section == Section.People)
                {
                    <BidTeamSection ProposalId="ProposalId" Members="_proposal.Members"
                                    CanManage="_canManageTeam" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Settings)
                {
                    <h2 class="section-heading">Settings</h2>
                    @if (_myRole != ProposalRole.Owner)
                    {
                        <p class="text-muted">Only the owner can change the proposal's settings.</p>
                    }
                    else
                    {
                        <div class="card">
                            <div class="form-field">
                                <label for="settings-title">Proposal name</label>
                                <input id="settings-title" type="text" @bind="_settingsTitle" />
                            </div>
                            <div class="form-field">
                                <label for="settings-client">Client name<span class="label-hint">(optional)</span></label>
                                <input id="settings-client" type="text" @bind="_settingsClientName" />
                            </div>
                            @if (_settingsError is not null)
                            {
                                <p class="error-text">@_settingsError</p>
                            }
                            <div class="modal-actions" style="justify-content: flex-start; margin-top: 0.75rem;">
                                <button class="btn btn-primary" @onclick="SaveSettingsAsync" disabled="@_busy">Save changes</button>
                                @if (_settingsSaved)
                                {
                                    <span class="text-muted" style="align-self: center;">Saved.</span>
                                }
                            </div>
                        </div>

                        <div class="section-title">Archive</div>
                        <div class="card">
                            <p style="margin-top: 0;">
                                @(_proposal.IsArchived
                                    ? "This proposal is archived. It stays fully readable and is listed under Archived on the dashboard."
                                    : "Archiving moves the proposal out of the active list on the dashboard. Nothing is deleted.")
                            </p>
                            @if (_proposal.IsArchived)
                            {
                                <button class="btn btn-outline" @onclick="() => SetArchivedAsync(false)">Unarchive proposal</button>
                            }
                            else
                            {
                                <button class="btn btn-outline" @onclick="() => SetArchivedAsync(true)">Archive proposal</button>
                            }
                        </div>

                        <div class="section-title">Delete</div>
                        <div class="card danger-zone">
                            <p style="margin-top: 0;">
                                Deleting moves the proposal to the recycle bin on the dashboard. Nothing is erased –
                                you or any other team member can restore it from there.
                            </p>
                            <button class="btn btn-danger" @onclick="OpenDelete">Delete proposal</button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (_showDelete)
    {
        <div class="modal-backdrop" @onclick="() => _showDelete = false">
            <div class="modal-panel" @onclick:stopPropagation>
                <h2 class="modal-title">Delete proposal</h2>
                <p>
                    Move <strong>@_proposal.Title</strong> to the recycle bin? It disappears from the dashboard
                    and can no longer be opened, but all material, artifacts and history are kept and any team
                    member can restore it.
                </p>
                <div class="form-field">
                    <label for="delete-confirm">Type <strong>Yes</strong> to confirm</label>
                    <input id="delete-confirm" type="text" autocomplete="off" value="@_deleteConfirm"
                           @oninput="e => _deleteConfirm = (string?)e.Value ?? string.Empty" />
                </div>
                <div class="modal-actions">
                    <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@(_busy || !DeleteConfirmed)">
                        Delete proposal
                    </button>
                    <button class="btn btn-outline" @onclick="() => _showDelete = false">Cancel</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid ProposalId { get; set; }

    /// <summary>Which tab the URL names. Null on the bare route, which becomes Materials.</summary>
    [Parameter] public string? SectionSlug { get; set; }

    /// <summary>
    /// The conversation open inside the tab, passed through untouched to whichever section
    /// understands it — a chat id, the "new" literal, or null for neither.
    /// </summary>
    [Parameter] public string? SubId { get; set; }

    /// <summary>
    /// Sections still being built. Their nav items are greyed out and inert until
    /// <see cref="DraftSectionsEnabled"/> is flipped back on.
    /// </summary>
    private const bool DraftSectionsEnabled = false;

    private static readonly Section[] DraftSections =
    [
        Section.Generate, Section.ClientProfile, Section.Summary, Section.Requirements,
        Section.Scoping, Section.SolutionProposal, Section.Structure, Section.Content,
        Section.Export, Section.Review,
    ];

    private static bool IsDraft(Section section) => !DraftSectionsEnabled && DraftSections.Contains(section);

    /// <summary>
    /// Where a nav item points, or null for a section that is not open yet: an anchor with no href
    /// is inert and skipped by Tab on its own, which is what the greyed-out items need now that
    /// they are links rather than disabled buttons.
    /// </summary>
    private string? Href(Section section)
        => IsDraft(section) ? null : ProposalSectionUrl.For(ProposalId, section);

    private Proposal? _proposal;
    private List<Artifact> _artifacts = [];
    private int _unreadChats;
    private int _unreadTeam;
    private ProposalRole _myRole;
    private Section _section = Section.Material;
    private bool _notFound;
    private bool _showDelete;
    private bool _busy;
    private bool _disposed;

    /// <summary>Coalescing flags for <see cref="RefreshUsageAsync"/>: one query at a time, and one
    /// more afterwards if calls were recorded while it ran.</summary>
    private bool _usageRefreshing;
    private bool _usageRefreshAgain;

    /// <summary>The header this page last published, so Dispose only clears it if it is still up.</summary>
    private int _headerPublication;

    /// <summary>
    /// Who may add or remove team members — wider than the Owner check the rest of this page uses,
    /// and mirroring ProposalService: the owner, an admin already on the bid, or a super admin.
    /// It is how a super admin with read-only oversight joins a bid they need to work on.
    /// </summary>
    private bool _canManageTeam;

    private string _settingsTitle = "";
    private string _settingsClientName = "";
    private string? _settingsError;
    private bool _settingsSaved;
    private string _deleteConfirm = "";

    private bool DeleteConfirmed => string.Equals(_deleteConfirm.Trim(), "Yes", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        // Bare /proposals/{id}, a slug nobody recognises, or a section that is not open yet becomes
        // Materials: the menu should never render with nothing highlighted, and the URL should say
        // which tab you are on, so Back returns you to it. Replacing rather than pushing keeps the
        // bounce out of the history stack. The return matters — BlazorDisableThrowNavigationException
        // is on, so NavigateTo does not unwind during static rendering and the rest would still run.
        if (ProposalSectionUrl.Parse(SectionSlug) is not { } section || IsDraft(section))
        {
            Nav.NavigateTo(ProposalSectionUrl.For(ProposalId, Section.Material), replace: true);
            return;
        }
        _section = section;
        await LoadAsync();
        if (_section == Section.Settings && _proposal is not null) SeedSettings();
    }

    /// <summary>The materials tab, for the link out of an empty picker in AI Chat.</summary>
    private void GoToMaterials()
        => Nav.NavigateTo(ProposalSectionUrl.For(ProposalId, Section.Material));

    protected override void OnInitialized()
    {
        TeamChatNotifier.Posted += OnTeamPosted;
        AiUsageNotifier.Recorded += OnUsageRecorded;
    }

    public void Dispose()
    {
        _disposed = true;
        TeamChatNotifier.Posted -= OnTeamPosted;
        AiUsageNotifier.Recorded -= OnUsageRecorded;
        Header.ClearIfCurrent(_headerPublication);
    }

    /// <summary>
    /// Keeps the team badge live while you are sitting on another tab, where the section
    /// component is not rendered at all and cannot hear the post for us.
    /// </summary>
    private void OnTeamPosted(Guid proposalId, Guid threadId)
    {
        if (_disposed || proposalId != ProposalId) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await RefreshTeamUnreadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        var user = await CurrentUser.GetAsync();
        var result = await Proposals.GetForUserAsync(ProposalId, user.Id);
        if (result is null)
        {
            _notFound = true;
            _headerPublication = Header.Clear();
            return;
        }
        (_proposal, _myRole) = result.Value;
        _canManageTeam = _myRole == ProposalRole.Owner
            || user.IsSuperAdmin
            || user.IsAdmin && _proposal.Members.Any(m => m.UserId == user.Id);
        _artifacts = await Artifacts.GetAllAsync(ProposalId, user.Id);
        _unreadChats = await Chat.UnreadCountAsync(ProposalId, user.Id);
        _unreadTeam = await TeamChat.UnreadCountAsync(ProposalId, user.Id);
        _headerPublication = Header.Set(_proposal.Title, _proposal.ClientName,
            _proposal.IsArchived ? "Archived" : null, ProposalId);
        await RefreshUsageAsync();
    }

    /// <summary>
    /// The app bar's running spend figure. Published through the header rather than rendered here
    /// because it belongs beside Settings, and re-read from the rows rather than accumulated, so a
    /// teammate generating against the same bid moves it too.
    /// <para>
    /// Coalesced rather than debounced: a content generation records one call per unit, requirements
    /// extraction one per chunk, and a single upload one per embedded figure, so the events arrive in
    /// bursts of tens. Folding a burst into the query already in flight plus one more afterwards
    /// leaves the figure final without a timer to own and dispose.
    /// </para>
    /// </summary>
    private async Task RefreshUsageAsync()
    {
        if (_usageRefreshing)
        {
            _usageRefreshAgain = true;
            return;
        }
        _usageRefreshing = true;
        try
        {
            do
            {
                _usageRefreshAgain = false;
                var user = await CurrentUser.GetAsync();
                Header.SetUsageCost(ProposalId,
                    await Usage.GetProposalCostUsdAsync(ProposalId, user.Id));
            } while (_usageRefreshAgain && !_disposed);
        }
        finally
        {
            _usageRefreshing = false;
        }
    }

    /// <summary>
    /// Keeps the spend figure live on the tabs that spend without reloading this page — AI Chat and
    /// Materials, the two paths with no OnChanged of their own — and while a teammate spends on the
    /// same bid. No StateHasChanged: the figure belongs to the app bar, which re-renders itself off
    /// Header.Changed. Fired from whichever thread wrote the row, so the work goes back on the circuit.
    /// </summary>
    private void OnUsageRecorded(Guid proposalId)
    {
        if (_disposed || proposalId != ProposalId) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await RefreshUsageAsync();
        });
    }

    /// <summary>
    /// Fills the settings form from the proposal. Called when the tab is arrived at rather than from
    /// <see cref="LoadAsync"/>, which SaveSettingsAsync and every child's OnChanged also call — doing
    /// it there would overwrite a name while it was being typed.
    /// </summary>
    private void SeedSettings()
    {
        _settingsTitle = _proposal!.Title;
        _settingsClientName = _proposal.ClientName;
        _settingsError = null;
        _settingsSaved = false;
    }

    /// <summary>
    /// Chats with messages this user has not seen. Refreshed on load and on every section switch,
    /// the same staleness the artifact flags already have â€” no timer, no polling.
    /// </summary>
    private RenderFragment? ChatBadge()
        => _unreadChats == 0
            ? null
            : @<span class="nav-flag nav-flag-count" title="Chats with new messages">@_unreadChats</span>;

    private async Task RefreshUnreadAsync()
    {
        var user = await CurrentUser.GetAsync();
        _unreadChats = await Chat.UnreadCountAsync(ProposalId, user.Id);
    }

    /// <summary>Messages in the team thread this user has not read.</summary>
    private RenderFragment? TeamBadge()
        => _unreadTeam == 0
            ? null
            : @<span class="nav-flag nav-flag-count" title="Unread team messages">@_unreadTeam</span>;

    private async Task RefreshTeamUnreadAsync()
    {
        var user = await CurrentUser.GetAsync();
        _unreadTeam = await TeamChat.UnreadCountAsync(ProposalId, user.Id);
    }

    private RenderFragment? ArtifactBadge(ArtifactType type)
    {
        var artifact = _artifacts.FirstOrDefault(a => a.Type == type);
        if (artifact is not { IsLocked: true }) return null;
        return @<span class="nav-flag nav-flag-lock" title="Locked"><LockIcon /></span>;
    }

    /// <summary>Dims the nav item's title until its artifact has actually been generated.</summary>
    private string? ArtifactPendingClass(ArtifactType type)
    {
        var artifact = _artifacts.FirstOrDefault(a => a.Type == type);
        return artifact is null || artifact.Status == ArtifactStatus.Empty ? "nav-item-pending" : null;
    }

    private async Task SaveSettingsAsync()
    {
        _busy = true;
        _settingsError = null;
        _settingsSaved = false;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Proposals.UpdateDetailsAsync(ProposalId, user.Id, _settingsTitle, _settingsClientName);
            await LoadAsync();
            _settingsSaved = true;
        }
        catch (Exception ex)
        {
            _settingsError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetArchivedAsync(bool archived)
    {
        var user = await CurrentUser.GetAsync();
        await Proposals.SetArchivedAsync(ProposalId, user.Id, archived);
        await LoadAsync();
    }

    private void OpenDelete()
    {
        _deleteConfirm = "";
        _showDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (!DeleteConfirmed) return;
        _busy = true;
        var user = await CurrentUser.GetAsync();
        await Proposals.DeleteAsync(ProposalId, user.Id);
        _headerPublication = Header.Clear();
        Nav.NavigateTo("/");
    }
}
