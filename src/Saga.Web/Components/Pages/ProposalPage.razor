@page "/proposals/{ProposalId:guid}"
@implements IDisposable
@inject ProposalService Proposals
@inject ArtifactService Artifacts
@inject ChatService Chat
@inject TeamChatService TeamChat
@inject TeamChatNotifier TeamChatNotifier
@inject CurrentUserService CurrentUser
@inject AppHeaderState Header
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Saga — @(_proposal?.Title ?? "Proposal")</PageTitle>

@if (_notFound)
{
    <div class="empty-state">
        <p>This proposal does not exist, or you do not have access to it.</p>
        <a class="btn btn-outline" href="/">Back to proposals</a>
    </div>
}
else if (_proposal is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="workspace">
        <nav class="workspace-nav">
            <button class="nav-item @(_section == Section.Material ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Material)">Materials</button>
            <button class="nav-item @(_section == Section.Generate ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Generate)">Generate</button>
            <div class="nav-divider"></div>
            <button class="nav-item @(_section == Section.Chat ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Chat)">AI Chat @ChatBadge()</button>
            <button class="nav-item @(_section == Section.BidTeamChat ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.BidTeamChat)">Bid Team Chat @TeamBadge()</button>
            <div class="nav-divider"></div>
            <button class="nav-item @(_section == Section.ClientProfile ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.ClientProfile)">Client profile @ArtifactBadge(ArtifactType.ClientProfile)</button>
            <button class="nav-item @(_section == Section.Summary ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Summary)">Summary @ArtifactBadge(ArtifactType.Summary)</button>
            <button class="nav-item @(_section == Section.Requirements ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Requirements)">Requirements @ArtifactBadge(ArtifactType.Requirements)</button>
            <button class="nav-item @(_section == Section.Scoping ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Scoping)">Scoping @ArtifactBadge(ArtifactType.Scoping)</button>
            <button class="nav-item @(_section == Section.SolutionProposal ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.SolutionProposal)">Solution @ArtifactBadge(ArtifactType.SolutionProposal)</button>
            <div class="nav-divider"></div>
            <button class="nav-item @(_section == Section.Structure ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Structure)">Structure @ArtifactBadge(ArtifactType.Structure)</button>
            <button class="nav-item @(_section == Section.Content ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Content)">Content @ArtifactBadge(ArtifactType.Content)</button>
            <div class="nav-divider"></div>
            <button class="nav-item @(_section == Section.Export ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Export)">Export</button>
            <div class="nav-divider"></div>
            <button class="nav-item @(_section == Section.Review ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Review)">Review</button>
            <div class="nav-divider"></div>
            <button class="nav-item @(_section == Section.Usage ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Usage)">Usage</button>
            <button class="nav-item @(_section == Section.People ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.People)">Bid Team</button>
            <button class="nav-item @(_section == Section.Settings ? "active" : null)"
                    @onclick="() => SelectSectionAsync(Section.Settings)">Settings</button>
        </nav>

        <div class="workspace-main @(_section is Section.Chat or Section.BidTeamChat ? "flush" : null)">
            <div class="workspace-content">
                @if (_section == Section.Material)
                {
                    <MaterialSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor" />
                }
                else if (_section == Section.Generate)
                {
                    <GenerateSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor"
                                     OnChanged="LoadAsync" />
                }
                else if (_section == Section.Summary)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.Summary" Title="Summary"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Requirements)
                {
                    <RequirementsSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor"
                                         OnChanged="LoadAsync" />
                }
                else if (_section == Section.ClientProfile)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.ClientProfile" Title="Client profile"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Scoping)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.Scoping" Title="Scoping"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.SolutionProposal)
                {
                    <ProseArtifactSection ProposalId="ProposalId" Type="ArtifactType.SolutionProposal" Title="Solution"
                                          CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Structure)
                {
                    <StructureSection ProposalId="ProposalId" OutputFormat="_proposal.OutputFormat"
                                      CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Content)
                {
                    <ContentSection ProposalId="ProposalId" OutputFormat="_proposal.OutputFormat"
                                    CanEdit="_myRole >= ProposalRole.Editor" OnChanged="LoadAsync" />
                }
                else if (_section == Section.Review)
                {
                    <ReviewSection ProposalId="ProposalId" CanEdit="_myRole >= ProposalRole.Editor" />
                }
                else if (_section == Section.Chat)
                {
                    <ChatSection ProposalId="ProposalId" MyRole="_myRole"
                                 TeammateCount="_proposal.Members.Count - 1"
                                 OnUnreadChanged="RefreshUnreadAsync" />
                }
                else if (_section == Section.BidTeamChat)
                {
                    <BidTeamChatSection ProposalId="ProposalId" OnUnreadChanged="RefreshTeamUnreadAsync" />
                }
                else if (_section == Section.Export)
                {
                    <ExportSection ProposalId="ProposalId" />
                }
                else if (_section == Section.Usage)
                {
                    <UsageSection ProposalId="ProposalId" />
                }
                else if (_section == Section.People)
                {
                    <h2 class="section-heading">Bid Team</h2>
                    @if (_myRole == ProposalRole.Owner)
                    {
                        <div class="card">
                            <div class="section-title" style="margin-top: 0;">Add team member</div>
                            <div class="team-add-row">
                                <div class="form-field" style="flex: 2; min-width: 220px; margin-bottom: 0;">
                                    <label for="share-email">Mannaz user email</label>
                                    <input id="share-email" type="email" @bind="_shareEmail" placeholder="name@mannaz.com" />
                                </div>
                                <div class="form-field" style="flex: 1; min-width: 200px; margin-bottom: 0;">
                                    <label for="share-role">Role</label>
                                    <select id="share-role" @bind="_shareRole">
                                        <option value="@ProposalRole.Editor">Editor</option>
                                        <option value="@ProposalRole.Reader">Reader</option>
                                    </select>
                                </div>
                                <button class="btn btn-primary" @onclick="ShareAsync" disabled="@_busy">Add</button>
                            </div>
                            @if (_shareError is not null)
                            {
                                <p class="error-text" style="margin-bottom: 0;">@_shareError</p>
                            }
                        </div>
                    }

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                @if (_myRole == ProposalRole.Owner)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in _proposal.Members.OrderByDescending(m => m.Role))
                            {
                                <tr>
                                    <td>@member.User?.DisplayName</td>
                                    <td>@member.User?.Email</td>
                                    <td><span class="badge badge-role">@member.Role</span></td>
                                    @if (_myRole == ProposalRole.Owner)
                                    {
                                        <td style="text-align: right;">
                                            @if (member.Role != ProposalRole.Owner)
                                            {
                                                <button class="btn btn-outline btn-sm" @onclick="() => RemoveMemberAsync(member.UserId)">Remove</button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (_section == Section.Settings)
                {
                    <h2 class="section-heading">Settings</h2>
                    @if (_myRole != ProposalRole.Owner)
                    {
                        <p class="text-muted">Only the owner can change the proposal's settings.</p>
                    }
                    else
                    {
                        <div class="card">
                            <div class="form-field">
                                <label for="settings-title">Proposal name</label>
                                <input id="settings-title" type="text" @bind="_settingsTitle" />
                            </div>
                            <div class="form-field">
                                <label for="settings-client">Client name</label>
                                <input id="settings-client" type="text" @bind="_settingsClientName" />
                            </div>
                            @if (_settingsError is not null)
                            {
                                <p class="error-text">@_settingsError</p>
                            }
                            <div class="modal-actions" style="justify-content: flex-start; margin-top: 0.75rem;">
                                <button class="btn btn-primary" @onclick="SaveSettingsAsync" disabled="@_busy">Save changes</button>
                                @if (_settingsSaved)
                                {
                                    <span class="text-muted" style="align-self: center;">Saved.</span>
                                }
                            </div>
                        </div>

                        <div class="section-title">Archive</div>
                        <div class="card">
                            <p style="margin-top: 0;">
                                @(_proposal.IsArchived
                                    ? "This proposal is archived. It stays fully readable and is listed under Archived on the dashboard."
                                    : "Archiving moves the proposal out of the active list on the dashboard. Nothing is deleted.")
                            </p>
                            @if (_proposal.IsArchived)
                            {
                                <button class="btn btn-outline" @onclick="() => SetArchivedAsync(false)">Unarchive proposal</button>
                            }
                            else
                            {
                                <button class="btn btn-outline" @onclick="() => SetArchivedAsync(true)">Archive proposal</button>
                            }
                        </div>

                        <div class="section-title">Delete</div>
                        <div class="card danger-zone">
                            <p style="margin-top: 0;">
                                Deleting moves the proposal to the recycle bin on the dashboard. Nothing is erased —
                                you or any other team member can restore it from there.
                            </p>
                            <button class="btn btn-danger" @onclick="OpenDelete">Delete proposal</button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (_showDelete)
    {
        <div class="modal-backdrop" @onclick="() => _showDelete = false">
            <div class="modal-panel" @onclick:stopPropagation>
                <h2 class="modal-title">Delete proposal</h2>
                <p>
                    Move <strong>@_proposal.Title</strong> to the recycle bin? It disappears from the dashboard
                    and can no longer be opened, but all material, artifacts and history are kept and any team
                    member can restore it.
                </p>
                <div class="form-field">
                    <label for="delete-confirm">Type <strong>Yes</strong> to confirm</label>
                    <input id="delete-confirm" type="text" autocomplete="off" value="@_deleteConfirm"
                           @oninput="e => _deleteConfirm = (string?)e.Value ?? string.Empty" />
                </div>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="() => _showDelete = false">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@(_busy || !DeleteConfirmed)">
                        Delete proposal
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid ProposalId { get; set; }

    private enum Section { Material, Generate, ClientProfile, Summary, Requirements, Scoping, SolutionProposal, Structure, Content, Review, Chat, BidTeamChat, Export, Usage, People, Settings }

    private Proposal? _proposal;
    private List<Artifact> _artifacts = [];
    private int _unreadChats;
    private int _unreadTeam;
    private ProposalRole _myRole;
    private Section _section = Section.Material;
    private bool _notFound;
    private bool _showDelete;
    private bool _busy;
    private bool _disposed;
    private string _shareEmail = "";
    private ProposalRole _shareRole = ProposalRole.Editor;
    private string? _shareError;

    private string _settingsTitle = "";
    private string _settingsClientName = "";
    private string? _settingsError;
    private bool _settingsSaved;
    private string _deleteConfirm = "";

    private bool DeleteConfirmed => string.Equals(_deleteConfirm.Trim(), "Yes", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override void OnInitialized() => TeamChatNotifier.Posted += OnTeamPosted;

    public void Dispose()
    {
        _disposed = true;
        TeamChatNotifier.Posted -= OnTeamPosted;
        Header.Clear();
    }

    /// <summary>
    /// Keeps the team badge live while you are sitting on another tab, where the section
    /// component is not rendered at all and cannot hear the post for us.
    /// </summary>
    private void OnTeamPosted(Guid proposalId)
    {
        if (_disposed || proposalId != ProposalId) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await RefreshTeamUnreadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        var user = await CurrentUser.GetAsync();
        var result = await Proposals.GetForUserAsync(ProposalId, user.Id);
        if (result is null)
        {
            _notFound = true;
            Header.Clear();
            return;
        }
        (_proposal, _myRole) = result.Value;
        _artifacts = await Artifacts.GetAllAsync(ProposalId, user.Id);
        _unreadChats = await Chat.UnreadCountAsync(ProposalId, user.Id);
        _unreadTeam = await TeamChat.UnreadCountAsync(ProposalId, user.Id);
        Header.Set(_proposal.Title, _proposal.ClientName, _proposal.IsArchived ? "Archived" : null);
    }

    private async Task SelectSectionAsync(Section section)
    {
        _section = section;
        if (section == Section.Settings)
        {
            _settingsTitle = _proposal!.Title;
            _settingsClientName = _proposal.ClientName;
            _settingsError = null;
            _settingsSaved = false;
        }
        // Refresh nav badges: edits inside the previous section may have changed the artifacts.
        await LoadAsync();
    }

    /// <summary>
    /// Chats with messages this user has not seen. Refreshed on load and on every section switch,
    /// the same staleness the artifact flags already have â€” no timer, no polling.
    /// </summary>
    private RenderFragment? ChatBadge()
        => _unreadChats == 0
            ? null
            : @<span class="nav-flag nav-flag-count" title="Chats with new messages">@_unreadChats</span>;

    private async Task RefreshUnreadAsync()
    {
        var user = await CurrentUser.GetAsync();
        _unreadChats = await Chat.UnreadCountAsync(ProposalId, user.Id);
    }

    /// <summary>Messages in the team thread this user has not read.</summary>
    private RenderFragment? TeamBadge()
        => _unreadTeam == 0
            ? null
            : @<span class="nav-flag nav-flag-count" title="Unread team messages">@_unreadTeam</span>;

    private async Task RefreshTeamUnreadAsync()
    {
        var user = await CurrentUser.GetAsync();
        _unreadTeam = await TeamChat.UnreadCountAsync(ProposalId, user.Id);
    }

    private RenderFragment? ArtifactBadge(ArtifactType type)
    {
        var artifact = _artifacts.FirstOrDefault(a => a.Type == type);
        if (artifact is null || artifact.Status == ArtifactStatus.Empty) return null;
        if (artifact.IsLocked)
        {
            return @<span class="nav-flag nav-flag-lock" title="Locked"><LockIcon /></span>;
        }
        return @<span class="nav-flag nav-flag-ok" title="Created">●</span>;
    }

    private async Task ShareAsync()
    {
        _busy = true;
        _shareError = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Proposals.ShareAsync(ProposalId, user.Id, _shareEmail, _shareRole);
            _shareEmail = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _shareError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveMemberAsync(Guid memberUserId)
    {
        var user = await CurrentUser.GetAsync();
        await Proposals.RemoveMemberAsync(ProposalId, user.Id, memberUserId);
        await LoadAsync();
    }

    private async Task SaveSettingsAsync()
    {
        _busy = true;
        _settingsError = null;
        _settingsSaved = false;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Proposals.UpdateDetailsAsync(ProposalId, user.Id, _settingsTitle, _settingsClientName);
            await LoadAsync();
            _settingsSaved = true;
        }
        catch (Exception ex)
        {
            _settingsError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetArchivedAsync(bool archived)
    {
        var user = await CurrentUser.GetAsync();
        await Proposals.SetArchivedAsync(ProposalId, user.Id, archived);
        await LoadAsync();
    }

    private void OpenDelete()
    {
        _deleteConfirm = "";
        _showDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (!DeleteConfirmed) return;
        _busy = true;
        var user = await CurrentUser.GetAsync();
        await Proposals.DeleteAsync(ProposalId, user.Id);
        Header.Clear();
        Nav.NavigateTo("/");
    }
}
