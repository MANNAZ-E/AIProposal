@page "/"
@inject ProposalService Proposals
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Saga — Proposals</PageTitle>

<div class="page-header">
    <h1>Proposals</h1>
    <a class="btn btn-primary" href="/proposals/new">+ New proposal</a>
</div>

@if (_items is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    var active = _items.Where(p => !p.IsArchived).ToList();
    var archived = _items.Where(p => p.IsArchived).ToList();

    @if (active.Count == 0)
    {
        <div class="empty-state">
            <p>No proposals yet.</p>
            <a class="btn btn-primary" href="/proposals/new">Create your first proposal</a>
        </div>
    }
    else
    {
        <ProposalTable Items="active" OnOpen="Open" />
    }

    @if (archived.Count > 0)
    {
        <div class="section-title">Archived</div>
        <ProposalTable Items="archived" OnOpen="Open" />
    }
}

@code {
    private List<ProposalListItem>? _items;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUser.GetAsync();
        _items = await Proposals.GetDashboardAsync(user.Id);
    }

    private void Open(Guid id) => Nav.NavigateTo($"/proposals/{id}");
}
