@page "/"
@inject ProposalService Proposals
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Saga — Proposals</PageTitle>

<div class="page-header">
    <h1>Proposals</h1>
    <a class="btn btn-primary" href="/proposals/new">+ New proposal</a>
</div>

@if (_items is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    var active = _items.Where(p => !p.IsArchived).ToList();
    var archived = _items.Where(p => p.IsArchived).ToList();

    @if (active.Count == 0)
    {
        <div class="empty-state">
            <p>No proposals yet.</p>
            <a class="btn btn-primary" href="/proposals/new">Create your first proposal</a>
        </div>
    }
    else
    {
        <ProposalTable Items="active" OnOpen="Open" />
    }

    @if (archived.Count > 0)
    {
        <div class="section-title">Archived</div>
        <ProposalTable Items="archived" OnOpen="Open" />
    }

    @if (_deleted is { Count: > 0 })
    {
        <div class="section-title">Recycle bin</div>
        <p class="text-muted" style="margin-top: -0.4rem;">
            Deleted proposals are kept with all their material and history. Restore one to put it back
            on the dashboard.
        </p>
        <ProposalTable Items="_deleted" OnRestore="RestoreAsync" />
    }
}

@code {
    private List<ProposalListItem>? _items;
    private List<ProposalListItem>? _deleted;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var user = await CurrentUser.GetAsync();
        _items = await Proposals.GetDashboardAsync(user.Id);
        _deleted = await Proposals.GetRecycleBinAsync(user.Id);
    }

    private void Open(Guid id) => Nav.NavigateTo($"/proposals/{id}");

    private async Task RestoreAsync(Guid id)
    {
        var user = await CurrentUser.GetAsync();
        await Proposals.RestoreAsync(id, user.Id);
        await LoadAsync();
    }
}
