@page "/proposals/new"
@inject ProposalService Proposals
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Saga — New proposal</PageTitle>

<h1 class="page-heading">New proposal</h1>

<div class="card" style="max-width: 640px;">
    <EditForm Model="_model" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator />

        <div class="form-field">
            <label for="title">Proposal title</label>
            <InputText id="title" type="text" autofocus @bind-Value="_model.Title" />
            <ValidationMessage For="() => _model.Title" />
        </div>

        <div class="form-field">
            <label for="client">Client name <span class="label-hint">(optional)</span></label>
            <InputText id="client" type="text" @bind-Value="_model.ClientName" />
        </div>

        @if (_error is not null)
        {
            <p class="error-text">@_error</p>
        }

        <div class="modal-actions" style="justify-content: flex-start;">
            <button class="btn btn-primary" type="submit" disabled="@_saving">Create proposal</button>
            <a class="btn btn-outline" href="/">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    private readonly FormModel _model = new();
    private bool _saving;
    private string? _error;

    private async Task CreateAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            // The format can still be switched later, in the Generate and Structure steps.
            var id = await Proposals.CreateAsync(user.Id, _model.Title, _model.ClientName, null, _model.OutputFormat);
            Nav.NavigateTo($"/proposals/{id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _saving = false;
        }
    }

    private class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A title is required.")]
        public string Title { get; set; } = "";

        public string ClientName { get; set; } = "";

        public OutputFormat OutputFormat { get; set; } = OutputFormat.PowerPoint;
    }
}
