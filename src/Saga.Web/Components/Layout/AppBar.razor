@rendermode InteractiveServer
@implements IDisposable
@using Saga.Web.Auth
@inject AppHeaderState Header
@inject CurrentUserService CurrentUser

<header class="app-bar">
    <a class="app-brand" href="/">
        <span class="app-logo">Saga</span>
    </a>
    <div class="app-context">
        @if (!string.IsNullOrWhiteSpace(Header.Title))
        {
            <span class="app-context-title">@Header.Title</span>
            @if (!string.IsNullOrWhiteSpace(Header.Subtitle))
            {
                <span class="app-context-subtitle">@Header.Subtitle</span>
            }
            @if (!string.IsNullOrWhiteSpace(Header.Badge))
            {
                <span class="app-context-badge">@Header.Badge</span>
            }
        }
    </div>
    <div class="app-user">
        @if (_isAdmin)
        {
            <a class="app-nav-link" href="/admin">Admin</a>
        }
        <AuthorizeView>
            <Authorized>@context.User.Identity?.Name</Authorized>
        </AuthorizeView>
    </div>
</header>

@code {
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        Header.Changed += OnHeaderChanged;
        try { _isAdmin = (await CurrentUser.GetAsync()).IsAdmin; }
        catch (UnauthorizedAccessException) { _isAdmin = false; }
        catch (AccessRevokedException) { _isAdmin = false; }
    }

    public void Dispose() => Header.Changed -= OnHeaderChanged;

    private void OnHeaderChanged() => _ = InvokeAsync(StateHasChanged);
}
