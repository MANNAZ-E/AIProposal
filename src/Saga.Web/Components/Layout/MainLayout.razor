@inherits LayoutComponentBase
@using Saga.Web.Auth
@inject CurrentUserService CurrentUser

<div class="app-shell">
    <AppBar />
    <ImpersonationBanner />
    <main class="app-main">
        @if (_accessRevoked)
        {
            <div class="empty-state">
                <p>Your access to Saga has been revoked.</p>
            </div>
        }
        else
        {
            @Body
        }
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _accessRevoked;

    protected override async Task OnInitializedAsync()
    {
        try { await CurrentUser.GetAsync(); }
        catch (AccessRevokedException) { _accessRevoked = true; }
        catch (UnauthorizedAccessException) { /* not signed in — AuthorizeRouteView already handles this */ }
    }
}
