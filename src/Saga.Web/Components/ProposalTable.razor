@*
    Shared proposal list. With OnRestore set it renders the recycle-bin variant: rows are not
    clickable (a deleted proposal cannot be opened) and each row offers Restore instead.
*@
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Client</th>
            <th>Owner</th>
            <th>Your role</th>
            <th>@(IsRecycleBin ? "Deleted" : "Created")</th>
            @if (IsRecycleBin)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Items)
        {
            <tr class="@(IsRecycleBin ? null : "row-link")" @onclick="() => RowClickAsync(item.Id)">
                <td><strong>@item.Title</strong></td>
                <td>@item.ClientName</td>
                <td>@item.OwnerName</td>
                <td>
                    @if (item.MyRole is { } role)
                    {
                        <span class="badge badge-role">@role</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td class="text-muted">
                    @(IsRecycleBin
                        ? item.DeletedAt?.LocalDateTime.ToString("dd MMM yyyy") ?? "—"
                        : item.CreatedAt.LocalDateTime.ToString("dd MMM yyyy"))
                </td>
                @if (IsRecycleBin)
                {
                    <td style="text-align: right;">
                        <button class="btn btn-outline btn-sm" @onclick="() => OnRestore.InvokeAsync(item.Id)">Restore</button>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public required List<ProposalListItem> Items { get; set; }
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }

    /// <summary>Set to turn the table into the recycle-bin variant.</summary>
    [Parameter] public EventCallback<Guid> OnRestore { get; set; }

    private bool IsRecycleBin => OnRestore.HasDelegate;

    private Task RowClickAsync(Guid id) => IsRecycleBin ? Task.CompletedTask : OnOpen.InvokeAsync(id);
}
