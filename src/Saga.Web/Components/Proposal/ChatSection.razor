@inject ChatService Chat
@inject CurrentUserService CurrentUser
@inject WorkingContextService WorkingContext
@implements IDisposable

<div class="chat-layout">
    <ChatList Chats="_chats" SelectedId="_activeChatId" IsDraftActive="_isDraft"
              IsProposalOwner="MyRole == ProposalRole.Owner" Streaming="_streamingIds"
              OnSelect="SelectAsync" OnNew="NewChat" OnRename="RenameAsync" OnDelete="DeleteAsync" />

    <div class="chat-pane">
        @if (!_isDraft && _activeChatId is null)
        {
            <div></div>
            <div class="chat-scroll">
                <div class="empty-state">
                    @if (_chats.Count == 0)
                    {
                        <p>No chats yet. A chat answers questions about this proposal's material.</p>
                    }
                    else
                    {
                        <p class="text-muted">Select a chat, or start a new one.</p>
                    }
                    <button class="btn btn-primary" @onclick="NewChat">Start a chat</button>
                </div>
            </div>
            <div></div>
        }
        else
        {
            <div class="chat-header">
                <div class="chat-header-title">@(_isDraft ? "New chat" : ActiveChat?.Title)</div>
                <div class="chat-header-meta">
                    @if (_isDraft)
                    {
                        <text>Pick what this chat can read. It is locked once you ask the first question.</text>
                    }
                    else
                    {
                        <span class="chat-visibility">
                            @if (ActiveChat?.IsMine == true)
                            {
                                <button class="link-button" @onclick="() => _showVisibility = !_showVisibility">
                                    @VisibilityLabel(ActiveChat.Visibility) ▾
                                </button>
                                @if (_showVisibility)
                                {
                                    <div class="menu-backdrop" @onclick="() => _showVisibility = false"></div>
                                    <div class="menu-panel">
                                        <button @onclick="() => SetVisibilityAsync(ChatVisibility.Private)">
                                            🔒 Only me
                                        </button>
                                        <button @onclick="() => SetVisibilityAsync(ChatVisibility.Shared)">
                                            👥 Everyone on this proposal
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <text>👥 Shared by @ActiveChat?.OwnerName</text>
                            }
                        </span>
                        <text> · </text>
                        <button class="link-button" @onclick="() => _showMaterial = !_showMaterial">
                            @ContextLabel(ActiveChat?.WorkingContext ?? WorkingContextKind.FullProject)
                            · @SelectedDocumentCount of @_documents.Count files @(_showMaterial ? "▴" : "▾")
                        </button>
                        @if (MaterialHasChanged)
                        {
                            <span class="text-muted"> · Material has changed since this chat started.</span>
                        }
                    }
                </div>
            </div>

            <div class="chat-scroll">
                @if (_isDraft)
                {
                    <div class="card" style="margin-bottom: 1rem;">
                        <ChatMaterial Documents="_documents" Artifacts="_artifacts"
                                      SelectedDocuments="_selectedDocuments" SelectedArtifacts="_selectedArtifacts"
                                      Budget="WorkingContext.Budget"
                                      Preset="_draftKind" PresetChanged="k => _draftKind = k" />
                    </div>
                }
                else if (_showMaterial)
                {
                    <div class="card" style="margin-bottom: 1rem;">
                        <ChatMaterial Documents="_documents" Artifacts="_artifacts"
                                      SelectedDocuments="_selectedDocuments" SelectedArtifacts="_selectedArtifacts"
                                      ReadOnly="true" Preset="ActiveChat?.WorkingContext ?? WorkingContextKind.FullProject" />
                        <button class="btn btn-outline btn-sm" @onclick="NewChatWithSameMaterial">
                            New chat with this material
                        </button>
                    </div>
                }

                <div class="chat-thread">
                    @foreach (var message in _messages)
                    {
                        <div class="chat-message @(message.Role == ChatRole.User ? "chat-user" : "chat-assistant")">
                            <div class="chat-meta">
                                @(message.Role == ChatRole.User ? message.Author?.DisplayName ?? "You" : "Saga")
                                <span class="text-muted">· @message.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            @if (message.Role == ChatRole.User)
                            {
                                <p style="margin: 0; white-space: pre-wrap;">@message.Text</p>
                            }
                            else
                            {
                                <div class="markdown-body">@Markdown.Render(message.Text)</div>
                            }
                        </div>
                    }
                    @if (ActiveStreaming is not null)
                    {
                        <div class="chat-message chat-assistant">
                            <div class="chat-meta">Saga</div>
                            <div class="markdown-body">
                                @Markdown.Render(ActiveStreaming)
                                <span class="cursor-blink">▌</span>
                            </div>
                        </div>
                    }
                </div>

                @if (_error is not null)
                {
                    <p class="error-text">@_error</p>
                }
            </div>

            <div class="chat-composer">
                @if (CanPost)
                {
                    <div class="chat-input">
                        <textarea rows="2" placeholder="Ask about the material, the requirements, the proposal…"
                                  @bind="_question" @bind:event="oninput" disabled="@ActiveIsBusy"
                                  @onkeydown="OnKeyDown"></textarea>
                        <button class="btn btn-primary" @onclick="AskAsync"
                                disabled="@(ActiveIsBusy || string.IsNullOrWhiteSpace(_question))">
                            @(ActiveIsBusy ? "Answering…" : "Ask")
                        </button>
                    </div>
                }
                else
                {
                    <p class="text-muted" style="margin: 0.35rem 0;">
                        You have read-only access to this proposal, so you can read this chat but not
                        add to it. Start your own chat to ask a question.
                    </p>
                }
            </div>
        }
    </div>
</div>

@if (_confirmUnshare)
{
    @* The one modal in the feature: unsharing takes something away from people, including
       messages they wrote themselves. Sharing does not, so it needs no confirmation. *@
    <div class="modal-backdrop" @onclick="() => _confirmUnshare = false">
        <div class="modal-panel" @onclick:stopPropagation>
            <h2 class="modal-title">Make this chat private?</h2>
            <p>
                @if (TeammateCount == 1)
                {
                    <text>1 teammate will lose access to this chat, including anything they wrote in it.</text>
                }
                else
                {
                    <text>@TeammateCount teammates will lose access to this chat, including anything they wrote in it.</text>
                }
            </p>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="() => _confirmUnshare = false">Cancel</button>
                <button class="btn btn-danger" @onclick="UnshareAsync">Make private</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ProposalId { get; set; }
    [Parameter] public ProposalRole MyRole { get; set; }

    /// <summary>Everyone on the proposal except me — what an unshare would take the chat from.</summary>
    [Parameter] public int TeammateCount { get; set; }

    /// <summary>Lets the page refresh the unread badge on the Chat nav item.</summary>
    [Parameter] public EventCallback OnUnreadChanged { get; set; }

    private List<ChatListItem> _chats = [];
    private List<ChatMessage> _messages = [];

    /// <summary>Null with <see cref="_isDraft"/> false means "nothing selected".</summary>
    private Guid? _activeChatId;

    /// <summary>
    /// The one reusable unsaved chat. It has no database row until the first question lands, so
    /// abandoning it leaves nothing behind and pressing New again just reuses this slot.
    /// </summary>
    private bool _isDraft;
    private WorkingContextKind _draftKind = WorkingContextKind.FullProject;

    /// <summary>Everything the proposal has, for the picker and for naming what a chat froze.</summary>
    private List<Document> _documents = [];
    private List<Artifact> _artifacts = [];

    /// <summary>The draft's choice, or the started chat's frozen choice shown read-only.</summary>
    private HashSet<Guid> _selectedDocuments = [];
    private HashSet<ArtifactType> _selectedArtifacts = [];
    private bool _showMaterial;
    private bool _showVisibility;
    private bool _confirmUnshare;
    private ChatSession? _activeSession;

    /// <summary>Answers still streaming, keyed by chat id (the draft uses Guid.Empty), so
    /// switching chats mid-answer keeps filling the right buffer and the right row spins.</summary>
    private readonly Dictionary<Guid, string> _streaming = [];
    private HashSet<Guid> _streamingIds = [];

    private string _question = "";
    private string? _error;
    private bool _disposed;
    private Guid _loadedProposalId;

    private ChatListItem? ActiveChat => _chats.FirstOrDefault(c => c.Id == _activeChatId);
    private int SelectedDocumentCount => _selectedDocuments.Count;

    /// <summary>
    /// A Reader keeps their own chats — asking never modifies the proposal — but cannot add to a
    /// chat someone else shared. Disabling the composer says so before the service has to.
    /// </summary>
    private bool CanPost => _isDraft || ActiveChat?.IsMine == true || MyRole >= ProposalRole.Editor;

    /// <summary>
    /// A chat answers from what it froze, so material edited since then is invisible to it. Say so
    /// rather than letting someone wonder why a new upload is being ignored.
    /// </summary>
    private bool MaterialHasChanged
        => _activeSession is not null
           && (_documents.Any(d => _selectedDocuments.Contains(d.Id) && d.UpdatedAt > _activeSession.CreatedAt)
               || _artifacts.Any(a => _selectedArtifacts.Contains(a.Type) && a.UpdatedAt > _activeSession.CreatedAt));
    private Guid ActiveKey => _isDraft ? Guid.Empty : _activeChatId ?? Guid.Empty;
    private string? ActiveStreaming => _streaming.TryGetValue(ActiveKey, out var text) ? text : null;
    private bool ActiveIsBusy => _streaming.ContainsKey(ActiveKey);

    public void Dispose() => _disposed = true;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProposalId == ProposalId) return;
        _loadedProposalId = ProposalId;
        var user = await CurrentUser.GetAsync();
        (_documents, _artifacts) = await Chat.GetMaterialAsync(ProposalId, user.Id);
        await LoadChatsAsync();
        if (_chats.Count > 0) await SelectAsync(_chats[0].Id);
    }

    private async Task LoadChatsAsync()
    {
        var user = await CurrentUser.GetAsync();
        _chats = await Chat.ListAsync(ProposalId, user.Id);
        _streamingIds = _streaming.Keys.ToHashSet();
    }

    private async Task SelectAsync(Guid chatId)
    {
        if (_activeChatId == chatId && !_isDraft) return;
        _error = null;
        _isDraft = false;
        _showMaterial = false;
        _activeChatId = chatId;
        var user = await CurrentUser.GetAsync();
        try
        {
            _messages = await Chat.GetMessagesAsync(chatId, user.Id);
            _activeSession = await Chat.GetChatAsync(chatId, user.Id);
            ShowFrozenSelection(_activeSession);
            // Opening a chat is the only place a read mark moves from the UI; the service skips
            // the write when it is already caught up, so this costs nothing on a re-render.
            await Chat.MarkSeenAsync(chatId, user.Id);
            await LoadChatsAsync();
            await OnUnreadChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            // Unshared or deleted while it sat on screen: the list is the source of truth.
            _error = ex.Message;
            _messages = [];
            _activeChatId = null;
            _activeSession = null;
            await LoadChatsAsync();
        }
    }

    /// <summary>
    /// A chat carried over from the single-thread era has nothing frozen yet, so it reads as
    /// everything — which is what its next question will actually freeze.
    /// </summary>
    private void ShowFrozenSelection(ChatSession session)
    {
        var frozen = MaterialSelection.FromJson(session.MaterialSelectionJson)
                     ?? MaterialSelection.Everything(_documents, _artifacts);
        _selectedDocuments = frozen.DocumentIds.ToHashSet();
        _selectedArtifacts = frozen.ArtifactTypes.ToHashSet();
    }

    private void NewChat()
    {
        _error = null;
        _isDraft = true;
        _showMaterial = false;
        _activeChatId = null;
        _activeSession = null;
        _messages = [];
        _question = "";
        _draftKind = WorkingContextKind.FullProject;
        var everything = MaterialSelection.Everything(_documents, _artifacts);
        _selectedDocuments = everything.DocumentIds.ToHashSet();
        _selectedArtifacts = everything.ArtifactTypes.ToHashSet();
    }

    private async Task SetVisibilityAsync(ChatVisibility visibility)
    {
        _showVisibility = false;
        if (ActiveChat is null || ActiveChat.Visibility == visibility) return;
        if (visibility == ChatVisibility.Private)
        {
            _confirmUnshare = true;
            return;
        }
        await ApplyVisibilityAsync(ChatVisibility.Shared);
    }

    private async Task UnshareAsync()
    {
        _confirmUnshare = false;
        await ApplyVisibilityAsync(ChatVisibility.Private);
    }

    private async Task ApplyVisibilityAsync(ChatVisibility visibility)
    {
        if (_activeChatId is null) return;
        _error = null;
        var user = await CurrentUser.GetAsync();
        try
        {
            await Chat.SetVisibilityAsync(_activeChatId.Value, user.Id, visibility);
            await LoadChatsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RenameAsync((Guid Id, string Title) rename)
    {
        _error = null;
        var user = await CurrentUser.GetAsync();
        try
        {
            await Chat.RenameAsync(rename.Id, user.Id, rename.Title);
            await LoadChatsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(Guid chatId)
    {
        _error = null;
        var user = await CurrentUser.GetAsync();
        try
        {
            await Chat.DeleteAsync(chatId, user.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        await LoadChatsAsync();
        if (_activeChatId == chatId)
        {
            // Land on the neighbour rather than on nothing.
            _activeChatId = null;
            _activeSession = null;
            _messages = [];
            if (_chats.Count > 0) await SelectAsync(_chats[0].Id);
        }
    }

    /// <summary>The escape hatch from the lock: same material, fresh chat.</summary>
    private void NewChatWithSameMaterial()
    {
        var documents = _selectedDocuments.ToHashSet();
        var artifacts = _selectedArtifacts.ToHashSet();
        var kind = ActiveChat?.WorkingContext ?? WorkingContextKind.FullProject;
        NewChat();
        _selectedDocuments = documents;
        _selectedArtifacts = artifacts;
        _draftKind = kind;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !ActiveIsBusy && !string.IsNullOrWhiteSpace(_question))
            await AskAsync();
    }

    private async Task AskAsync()
    {
        var question = _question.Trim();
        if (question.Length == 0 || ActiveIsBusy) return;

        _error = null;
        _question = "";
        var user = await CurrentUser.GetAsync();
        var askingDraft = _isDraft;
        // This ask owns one buffer. The key follows the answer, not the screen, so switching
        // chats mid-answer keeps the text landing in the right place.
        var streamKey = ActiveKey;
        _streaming[streamKey] = "";
        _streamingIds = _streaming.Keys.ToHashSet();

        _messages.Add(new ChatMessage
        {
            Role = ChatRole.User,
            Text = question,
            Author = user,
            CreatedAt = DateTimeOffset.UtcNow,
        });
        StateHasChanged();

        try
        {
            // The selection only travels on the first question; after that the chat replays what
            // it froze and this argument is ignored.
            var selection = askingDraft
                ? new MaterialSelection(_selectedDocuments.ToList(), _selectedArtifacts.ToList())
                : null;

            var (chatId, _) = await Chat.AskAsync(ProposalId, askingDraft ? null : streamKey, user.Id,
                question, _draftKind, selection,
                onChatCreated: async id =>
                {
                    // Re-key the buffer onto the real chat before the answer starts arriving, and
                    // free the draft slot, so pressing New again cannot duplicate this chat.
                    if (_streaming.Remove(streamKey, out var buffered)) _streaming[id] = buffered;
                    streamKey = id;
                    if (_isDraft)
                    {
                        _isDraft = false;
                        _activeChatId = id;
                    }
                    await LoadChatsAsync();
                    if (!_disposed) await InvokeAsync(StateHasChanged);
                },
                onDelta: async delta =>
                {
                    _streaming[streamKey] += delta;
                    if (!_disposed) await InvokeAsync(StateHasChanged);
                });

            _streaming.Remove(streamKey);
            if (_activeChatId == chatId)
            {
                _messages = await Chat.GetMessagesAsync(chatId, user.Id);
                _activeSession = await Chat.GetChatAsync(chatId, user.Id);
            }
            await LoadChatsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _streaming.Remove(streamKey);
        }
        finally
        {
            _streamingIds = _streaming.Keys.ToHashSet();
        }
    }

    private static string VisibilityLabel(ChatVisibility visibility)
        => visibility == ChatVisibility.Shared ? "👥 Shared with team" : "🔒 Private";

    private static string ContextLabel(WorkingContextKind kind) => kind switch
    {
        WorkingContextKind.SourceMaterial => "Source material",
        WorkingContextKind.Analysis => "Analysis",
        WorkingContextKind.Custom => "Selected material",
        _ => "Full project",
    };
}
