@inject TeamChatService TeamChat
@inject CurrentUserService CurrentUser
@inject TeamChatNotifier Notifier
@inject ChatDraftState Drafts
@inject IJSRuntime JS
@implements IDisposable

<div class="chat-layout">
    <TeamThreadList Threads="_threads" SelectedId="_activeThreadId" IsDraftActive="_isDraft"
                    OnSelect="SelectAsync" OnNew="NewThread"
                    OnRename="RenameAsync" OnDelete="DeleteAsync" />

    <div class="chat-pane">
        @if (!_isDraft && _activeThreadId is null)
        {
            @* A thread deleted from another circuit while it is on screen lands here rather than
               on a blank pane; opening the section always starts on a thread or on the draft. *@
            <div></div>
            <div class="chat-scroll">
                <div class="empty-state">
                    <p class="text-muted">Select a chat, or start a new one.</p>
                    <button class="btn btn-primary" @onclick="NewThread">Start a chat</button>
                </div>
            </div>
            <div></div>
        }
        else
        {
            <div class="chat-header">
                <div class="chat-header-title">@(_isDraft ? "New chat" : ActiveThread?.Title)</div>
            </div>

            @* Reversed flex column: with a single child the container opens scrolled to the bottom
               and stays pinned there as messages arrive, which is what a chat wants and what the
               project's no-JavaScript rule leaves as the only way to get it. *@
            <div class="team-scroll">
                <div class="team-thread">
                    @foreach (var message in _messages)
                    {
                        <div class="team-msg @BubbleClass(message)">
                            <div class="chat-meta">
                                @(message.AuthorId == _me ? "You" : message.Author?.DisplayName ?? "Someone")
                                <span class="text-muted">· @message.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            <div class="team-msg-body">@TeamMessageText.Render(message.Text, message.Mentions, _me)</div>
                        </div>
                    }
                </div>
            </div>

            <div class="chat-composer">
                <div class="team-composer">
                    @* Read once: the textarea needs to know whether the picker is up, to gate the script. *@
                    @{
                        var suggestions = Suggestions;
                        var picking = suggestions is { Count: > 0 };
                    }
                    @if (picking)
                    {
                        @* Focus stays in the textarea throughout: the highlight is state rather than DOM
                           focus, so typing keeps narrowing the list. mention-composer.js is what stops the
                           four navigation keys doing their textarea thing while this is open. *@
                        <div class="team-mention-picker" role="listbox">
                            @for (var i = 0; i < suggestions!.Count; i++)
                            {
                                var member = suggestions[i];
                                var isActive = i == ActiveIndex(suggestions.Count);
                                @* Spelled out: a bool would render aria-selected valueless, and ARIA wants the word. *@
                                <button type="button" role="option" tabindex="-1"
                                        aria-selected="@(isActive ? "true" : "false")"
                                        class="@(isActive ? "is-active" : null)"
                                        @onmousedown:preventDefault
                                        @onclick="() => CommitAsync(member)">
                                    <span class="team-mention-name">@member.DisplayName</span>
                                    <span class="text-muted">@member.Email</span>
                                </button>
                            }
                        </div>
                    }
                    <div class="chat-input">
                        <textarea rows="2" placeholder="Type a message - use @@ to tag and notify"
                                  @ref="_composer" data-mention-picker="@(picking ? "open" : null)"
                                  @bind="Draft" @bind:event="oninput" @onkeydown="OnKeyDown"></textarea>
                        <button class="btn btn-primary" @onclick="SendAsync"
                                disabled="@(_sending || string.IsNullOrWhiteSpace(Draft))">Send</button>
                    </div>
                    @if (_error is not null)
                    {
                        <p class="error-text" style="margin: 0.4rem 0 0;">@_error</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid ProposalId { get; set; }

    /// <summary>Lets the page refresh the unread badge on the Bid Team Chat nav item.</summary>
    [Parameter] public EventCallback OnUnreadChanged { get; set; }

    /// <summary>At most this many names in the picker; past that it stops being a shortcut.</summary>
    private const int MaxSuggestions = 6;

    /// <summary>A run longer than this is prose that happens to follow an '@', not a name.</summary>
    private const int MaxQueryLength = 40;

    private List<TeamThreadListItem> _threads = [];
    private List<TeamMessage> _messages = [];
    private List<TeamChatMember> _members = [];
    private Guid? _activeThreadId;

    /// <summary>
    /// The one reusable unstarted thread. Nothing is written until the first message lands, so
    /// abandoning it leaves nothing behind and pressing New again reuses this slot.
    /// </summary>
    private bool _isDraft;
    private Guid _me;
    private string? _error;
    private bool _sending;
    private bool _disposed;
    private Guid _loadedProposalId;

    /// <summary>
    /// The '@' whose picker Escape closed. Kept as an index rather than a flag so that starting a
    /// fresh mention opens the picker again without having to notice the keystroke that did it.
    /// </summary>
    private int _dismissedAt = -1;

    /// <summary>
    /// Which suggestion the keyboard is on. Starts at 0 so the top name is live the moment the
    /// picker opens, and every keystroke puts it back there because the list has just re-filtered.
    /// </summary>
    private int _active;

    /// <summary>The textarea, for handing the caret back once a name has been inserted.</summary>
    private ElementReference? _composer;

    /// <summary>
    /// The highlight, held against a list that may have shrunk under it since the last keystroke.
    /// </summary>
    private int ActiveIndex(int count) => count == 0 ? 0 : Math.Clamp(_active, 0, count - 1);

    private TeamThreadListItem? ActiveThread => _threads.FirstOrDefault(t => t.Id == _activeThreadId);

    /// <summary>The thread a draft belongs to; the unstarted one uses Guid.Empty.</summary>
    private Guid ActiveKey => _isDraft ? Guid.Empty : _activeThreadId ?? Guid.Empty;

    /// <summary>
    /// The composer's text, kept in the circuit rather than in a field: leaving the Bid Team Chat
    /// tab destroys this component, and a message half typed should survive that, exactly as an
    /// unsent question does in AI Chat.
    /// </summary>
    private string Draft
    {
        get => Drafts.Get(ProposalId, ChatDraftKind.TeamThread, ActiveKey);
        set
        {
            // Typing re-filters the picker, so the highlight belongs back on its new top name.
            _active = 0;
            Drafts.Set(ProposalId, ChatDraftKind.TeamThread, ActiveKey, value);
        }
    }

    protected override void OnInitialized() => Notifier.Posted += OnPosted;

    public void Dispose()
    {
        _disposed = true;
        Notifier.Posted -= OnPosted;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProposalId == ProposalId) return;
        _loadedProposalId = ProposalId;
        _me = (await CurrentUser.GetAsync()).Id;
        _members = await TeamChat.MembersAsync(ProposalId, _me);
        await LoadThreadsAsync();
        // The newest conversation, or a fresh draft on a proposal nobody has posted to yet.
        if (_threads.Count > 0) await SelectAsync(_threads[0].Id);
        else NewThread();
    }

    /// <summary>
    /// Somebody posted. The event fires on whichever circuit did the posting, so the work has to
    /// hop back onto this component's own synchronization context before it touches state. The
    /// list refreshes on any thread of this proposal — times and unread dots move — but the
    /// transcript reloads only when the thread on screen is the one that changed.
    /// </summary>
    private void OnPosted(Guid proposalId, Guid threadId)
    {
        if (_disposed || proposalId != ProposalId) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            if (threadId == _activeThreadId) await ReloadAsync();
            else await LoadThreadsAsync();
            StateHasChanged();
        });
    }

    private async Task LoadThreadsAsync()
    {
        _threads = await TeamChat.ListThreadsAsync(ProposalId, _me);
        await OnUnreadChanged.InvokeAsync();
    }

    /// <summary>Reloads the open thread, marks it read, and refreshes the list around it.</summary>
    private async Task ReloadAsync()
    {
        if (_activeThreadId is not { } threadId) return;
        _messages = await TeamChat.ListAsync(threadId, _me);
        // Reading the thread is what clears its dot; the service skips the write when the
        // watermark is already current, so this costs nothing on a reload that changed nothing.
        await TeamChat.MarkSeenAsync(threadId, _me);
        await LoadThreadsAsync();
    }

    private async Task SelectAsync(Guid threadId)
    {
        if (!_isDraft && _activeThreadId == threadId) return;
        _isDraft = false;
        _error = null;
        _dismissedAt = -1;
        // The other thread's draft may itself end in an '@' run, and its picker opens on the top name.
        _active = 0;
        _activeThreadId = threadId;
        try
        {
            await ReloadAsync();
        }
        catch (Exception)
        {
            // Deleted from another circuit while it sat in the list. Fall back to nothing selected
            // rather than leaving a thread on screen that no longer exists.
            _activeThreadId = null;
            _messages = [];
            await LoadThreadsAsync();
        }
    }

    private void NewThread()
    {
        _isDraft = true;
        _activeThreadId = null;
        _messages = [];
        _error = null;
        _dismissedAt = -1;
        _active = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Escape closes the picker for this '@', and with it the attribute the script watches, so
        // the four keys are handed straight back to the textarea.
        if (e.Key == "Escape")
        {
            _dismissedAt = MentionStart;
            _active = 0;
            return;
        }

        if (Suggestions is { Count: > 0 } picker)
        {
            _active = ActiveIndex(picker.Count);
            switch (e.Key)
            {
                // Wraps, so Up out of the top name is a move rather than a dead key.
                case "ArrowDown": _active = (_active + 1) % picker.Count; return;
                case "ArrowUp": _active = (_active + picker.Count - 1) % picker.Count; return;
                // Shift+Tab is left alone, so walking focus backwards still works.
                case "Tab" when !e.ShiftKey:
                case "Enter" when !e.ShiftKey:
                    await CommitAsync(picker[_active]);
                    return;
            }
        }

        // Enter sends, as it does in AI Chat. Shift+Enter is the newline.
        if (e.Key == "Enter" && !e.ShiftKey) await SendAsync();
    }

    /// <summary>
    /// Inserts a name and leaves the caret behind it. Blazor rewrites the whole textarea value, so
    /// the caret has to be placed again; the picker only opens on a run at the end of the draft,
    /// which is why the end of the value is the position just after the name.
    /// </summary>
    private async Task CommitAsync(TeamChatMember member)
    {
        Select(member);
        if (_composer is { } composer) await JS.InvokeVoidAsync("sagaMention.caretToEnd", composer);
    }

    private async Task SendAsync()
    {
        var text = Draft.Trim();
        if (text.Length == 0 || _sending) return;

        // Where this text lives now: starting a thread re-keys the composer onto the new thread,
        // and the slot to empty afterwards is the one it was typed into.
        var draftKey = ActiveKey;
        _sending = true;
        _error = null;
        try
        {
            if (_isDraft)
            {
                // The first message is what creates the thread, and what names it.
                var newId = await TeamChat.StartThreadAsync(ProposalId, _me, text);
                _isDraft = false;
                _activeThreadId = newId;
            }
            else if (_activeThreadId is { } threadId)
            {
                await TeamChat.PostAsync(threadId, _me, text);
            }
            else
            {
                return;
            }

            // Only once it is safely posted; a send that throws leaves the text to try again.
            Drafts.Set(ProposalId, ChatDraftKind.TeamThread, draftKey, "");
            _dismissedAt = -1;
            _active = 0;
            // The notifier reaches this circuit too, but reloading here keeps the send
            // synchronous with the click rather than with an event we also raised.
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task RenameAsync((Guid Id, string Title) rename)
    {
        _error = null;
        try
        {
            await TeamChat.RenameAsync(rename.Id, _me, rename.Title);
            await LoadThreadsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteAsync(Guid threadId)
    {
        _error = null;
        try
        {
            await TeamChat.DeleteAsync(threadId, _me);
            await LoadThreadsAsync();
            if (_activeThreadId != threadId) return;
            _activeThreadId = null;
            _messages = [];
            // Land on the neighbour, or on a fresh draft once the last thread is gone.
            if (_threads.Count > 0) await SelectAsync(_threads[0].Id);
            else NewThread();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>Replaces the half-typed run with the full name, at the caret's own position.</summary>
    private void Select(TeamChatMember member)
    {
        var start = MentionStart;
        if (start < 0) return;
        Draft = string.Concat(Draft.AsSpan(0, start), "@", member.DisplayName, " ");
        _dismissedAt = -1;
    }

    /// <summary>
    /// Index of the '@' that starts the mention being typed, or -1. The run has to sit at the end
    /// of the draft — that is where the caret is — start a word, and stay short enough to be a name.
    /// </summary>
    private int MentionStart
    {
        get
        {
            var draft = Draft;
            var at = draft.LastIndexOf('@');
            if (at < 0) return -1;
            if (at > 0 && !char.IsWhiteSpace(draft[at - 1])) return -1;
            var query = draft[(at + 1)..];
            if (query.Length > MaxQueryLength || query.Any(char.IsWhiteSpace)) return -1;
            return at;
        }
    }

    private List<TeamChatMember>? Suggestions
    {
        get
        {
            var start = MentionStart;
            if (start < 0 || start == _dismissedAt) return null;
            var query = Draft[(start + 1)..];
            return _members
                .Where(m => m.UserId != _me)
                .Where(m => query.Length == 0
                            || m.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase)
                            || m.Email.Contains(query, StringComparison.OrdinalIgnoreCase))
                .Take(MaxSuggestions)
                .ToList();
        }
    }

    /// <summary>
    /// Own messages are cream on the right; everyone else takes their colour from their position
    /// on the team, so a given person looks the same in everybody's window.
    /// </summary>
    private string BubbleClass(TeamMessage message)
    {
        if (message.AuthorId == _me) return "team-msg-mine";
        var slot = _members.FirstOrDefault(m => m.UserId == message.AuthorId)?.ColourSlot ?? 0;
        return $"team-msg-{slot + 1}";
    }
}
