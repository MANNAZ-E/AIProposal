@* The chat list pane. Two groups, because the question you have when you open it is
   "is this mine, or is someone else watching" — a badge on a flat list answers that slower. *@

<div class="chat-list">
    <div class="chat-list-header">
        <span class="chat-list-title">AI Chat</span>
    </div>

    @* The first row is the unstarted chat: it is both the button you press and the row you
       stand on while writing, so the two stop being separate things in separate places. *@
    <div class="chat-row-wrap chat-new-wrap">
        <button class="chat-row chat-new-row @(IsDraftActive ? "active" : null)" type="button"
                @onclick="StartNewAsync">
            <span class="chat-row-line">
                <span class="chat-row-title">＋ New chat</span>
                @if (Streaming.Contains(Guid.Empty))
                {
                    <span class="chat-row-time">⟳</span>
                }
            </span>
        </button>
    </div>

    @if (Mine.Count > 0)
    {
        <div class="chat-group">Mine</div>
        @foreach (var chat in Mine)
        {
            @Row(chat)
        }
    }

    @if (SharedWithMe.Count > 0)
    {
        <div class="chat-group">Shared with me</div>
        @foreach (var chat in SharedWithMe)
        {
            @Row(chat)
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public List<ChatListItem> Chats { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public bool IsDraftActive { get; set; }
    [Parameter] public bool IsProposalOwner { get; set; }
    [Parameter] public HashSet<Guid> Streaming { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback<(Guid Id, string Title)> OnRename { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private Guid? _menuFor;
    private Guid? _renameFor;
    private Guid? _deleteFor;
    private string _renameText = "";
    private ElementReference _renameInput;
    private bool _focusRename;

    private List<ChatListItem> Mine => Chats.Where(c => c.IsMine).ToList();
    private List<ChatListItem> SharedWithMe => Chats.Where(c => !c.IsMine).ToList();

    /// <summary>
    /// Pressing the row you are already standing on would reset the draft's material picker,
    /// so an active draft swallows the click rather than starting over.
    /// </summary>
    private Task StartNewAsync() => IsDraftActive ? Task.CompletedTask : OnNew.InvokeAsync();

    /// <summary>
    /// Someone else's shared chat is theirs: no rename, no delete. The exception is the proposal
    /// owner, who can delete it — otherwise a chat belonging to someone since removed from the
    /// proposal could never be cleaned up.
    /// </summary>
    private bool CanRename(ChatListItem chat) => chat.IsMine;
    private bool CanDelete(ChatListItem chat) => chat.IsMine || IsProposalOwner;

    private RenderFragment Row(ChatListItem chat) =>
        @<div class="chat-row-wrap">
            @if (_renameFor == chat.Id)
            {
                <div class="chat-row chat-row-editing">
                    <input class="chat-rename-input" @ref="_renameInput" value="@_renameText" @oninput="OnRenameInput"
                           @onkeydown="e => OnRenameKey(e, chat)" @onblur="() => OnRenameBlur(chat)" />
                </div>
            }
            else if (_deleteFor == chat.Id)
            {
                @* Confirming in the row itself: chats are cheap, and a modal for each one would
                   be heavier than the thing it is protecting. *@
                <div class="chat-row chat-row-editing">
                    <div class="chat-row-meta">
                        @(chat.Visibility == ChatVisibility.Shared
                            ? "Delete this chat? The team loses it too."
                            : "Delete this chat?")
                    </div>
                    <div class="chat-row-actions">
                        <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteAsync(chat)">Delete</button>
                        <button class="btn btn-outline btn-sm" @onclick="() => _deleteFor = null">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <button class="chat-row @(SelectedId == chat.Id ? "active" : null)" type="button"
                        @onclick="() => OnSelect.InvokeAsync(chat.Id)"
                        @ondblclick="() => TryStartRename(chat)">
                    <span class="chat-row-line">
                        <span class="chat-row-title @(chat.HasUnread ? "chat-unread" : null)">
                            @if (chat.HasUnread)
                            {
                                <span class="chat-unread-dot" title="New messages">●</span>
                            }
                            @chat.Title
                            @if (chat.IsMine && chat.Visibility == ChatVisibility.Shared)
                            {
                                <span class="text-muted chat-row-shared-flag" title="Shared with bid team"><PeopleIcon /></span>
                            }
                        </span>
                        <span class="chat-row-time">
                            @(Streaming.Contains(chat.Id) ? "⟳" : RelativeTime.Display(chat.LastMessageAt, DateTimeOffset.UtcNow))
                        </span>
                    </span>
                    @if (!chat.IsMine)
                    {
                        <span class="chat-row-meta">@chat.OwnerName</span>
                    }
                </button>

                @if (CanRename(chat) || CanDelete(chat))
                {
                    <button class="chat-row-menu" title="More" @onclick="() => _menuFor = chat.Id">⋯</button>
                }

                @if (_menuFor == chat.Id)
                {
                    @* No JS interop in this app, so dismissing on an outside click is a
                       transparent full-viewport catcher, the way the modals already work. *@
                    <div class="menu-backdrop" @onclick="() => _menuFor = null"></div>
                    <div class="menu-panel">
                        @if (CanRename(chat))
                        {
                            <button @onclick="() => StartRename(chat)">Rename</button>
                        }
                        @if (CanDelete(chat))
                        {
                            <button @onclick="() => StartDelete(chat)">Delete</button>
                        }
                    </div>
                }
            }
        </div>;

    private void TryStartRename(ChatListItem chat)
    {
        if (CanRename(chat)) StartRename(chat);
    }

    private void StartRename(ChatListItem chat)
    {
        _menuFor = null;
        _deleteFor = null;
        _renameText = chat.Title;
        _renameFor = chat.Id;
        _focusRename = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            await _renameInput.FocusAsync();
        }
    }

    private void StartDelete(ChatListItem chat)
    {
        _menuFor = null;
        _renameFor = null;
        _deleteFor = chat.Id;
    }

    private void OnRenameInput(ChangeEventArgs e) => _renameText = (string?)e.Value ?? "";

    private async Task OnRenameKey(KeyboardEventArgs e, ChatListItem chat)
    {
        if (e.Key == "Enter") await CommitRenameAsync(chat);
        else if (e.Key == "Escape") _renameFor = null;
    }

    /// <summary>
    /// Clicking away from the field (another row, "new chat", a different page) ends the
    /// edit without a keypress, so it needs the same save Enter gives it. Escape already
    /// cleared <see cref="_renameFor"/> before any blur reaches here, so this only fires
    /// for an edit that is still actually in progress.
    /// </summary>
    private async Task OnRenameBlur(ChatListItem chat)
    {
        if (_renameFor == chat.Id) await CommitRenameAsync(chat);
    }

    private async Task CommitRenameAsync(ChatListItem chat)
    {
        _renameFor = null;
        if (!string.IsNullOrWhiteSpace(_renameText) && _renameText != chat.Title)
            await OnRename.InvokeAsync((chat.Id, _renameText.Trim()));
    }

    private async Task ConfirmDeleteAsync(ChatListItem chat)
    {
        _deleteFor = null;
        await OnDelete.InvokeAsync(chat.Id);
    }
}
