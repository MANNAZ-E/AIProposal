@using Saga.Core.Abstractions
@using Saga.Core.Pipeline
@using Saga.Core.Tokenization
@inject DocumentService Documents
@inject CurrentUserService CurrentUser
@inject IDocumentTextExtractor TextExtractor
@inject IJSRuntime JS

<h2 class="section-heading">Materials</h2>

@if (_error is not null)
{
    <p class="error-text">@_error</p>
}

@if (CanEdit)
{
    <h3 class="material-heading">Upload files</h3>
    <div class="type-picker">
        <select id="upload-type" class="material-input" aria-label="Document type" @bind="_uploadTypeId" disabled="@_uploading">
            @foreach (var type in _types)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </select>
    </div>
    <label class="upload-area">
        <InputFile OnChange="UploadAsync" multiple accept="@_acceptTypes" disabled="@_uploading" />
        @if (_uploading)
        {
            <span>Uploading and extracting text… Please wait.</span>
        }
        else
        {
            <span><strong>Choose files</strong> or drop them here – PDF, Word, PowerPoint, Excel, images, text</span>
        }
    </label>

    <h3 class="material-heading">Add note</h3>
    <div class="type-picker">
        <select id="note-type" class="material-input" aria-label="Document type" @bind="_noteTypeId">
            @foreach (var type in _types)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </select>
    </div>
    <button type="button" class="btn btn-primary note-add-button" @onclick="NewNote">Add note</button>
}

@{
    RenderFragment<Document> documentRow = doc =>
        @<tr>
            <td>
                @if (_renameDocument?.Id == doc.Id)
                {
                    <input @ref="_renameInput" class="material-input rename-input" maxlength="500"
                           @bind="_renameValue" @bind:event="oninput"
                           @onkeydown="RenameKeyDownAsync" @onblur="SaveRenameAsync" />
                }
                else
                {
                    <div class="name-cell">
                        <button type="button" class="link-button" @onclick="() => OpenPreview(doc)">@doc.Name</button>
                        @if (_newDocumentIds.Contains(doc.Id))
                        {
                            <span class="badge badge-role">New</span>
                        }
                        @if (CanEdit)
                        {
                            <button type="button" class="rename-button" title="Rename"
                                    @onclick="() => BeginRename(doc)">✎</button>
                        }
                    </div>
                    @if (RenamedFrom(doc) is { } original)
                    {
                        <div class="name-original" title="Original file name">@original</div>
                    }
                }
            </td>
            <td>
                @if (!CanEdit)
                {
                    <span class="text-muted">@TypeName(doc)</span>
                }
                else if (_typeEditDocument?.Id == doc.Id)
                {
                    <select @ref="_typeSelect" class="material-input type-select"
                            @bind:get="doc.DocumentTypeId"
                            @bind:set="value => ChangeTypeAsync(doc, value)"
                            @onblur="() => _typeEditDocument = null">
                        @foreach (var type in _types)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                }
                else
                {
                    <button type="button" class="link-button type-cell" @onclick="() => BeginTypeEdit(doc)">
                        @TypeName(doc)<span class="type-caret">▾</span>
                    </button>
                }
            </td>
            <td class="text-muted" title="@TokenTitle(TokenBudget.TokensOf(doc))">@FormatTokens(TokenBudget.TokensOf(doc))</td>
            <td class="text-muted">@doc.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
            <td class="text-muted">@(doc.UpdatedAt > doc.CreatedAt ? doc.UpdatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm") : "–")</td>
            <td style="text-align: right; white-space: nowrap;">
                @if (CanEdit)
                {
                    <button class="btn btn-outline btn-sm" @onclick="() => BeginEdit(doc)">Edit</button>
                }
                <button class="btn btn-outline btn-sm" @onclick="() => OpenTextHistoryAsync(doc)">History</button>
                @if (CanEdit)
                {
                    <button class="btn btn-outline btn-sm" @onclick="() => OpenDelete(doc)">Delete</button>
                }
            </td>
        </tr>;
}

@if (_documents is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <h3 class="material-heading">
        <button type="button" class="heading-toggle" aria-expanded="@MaterialsOpen"
                @onclick="() => _materialsOpen = !MaterialsOpen">
            <span class="heading-caret">@(MaterialsOpen ? "▾" : "▸")</span>Materials
        </button>
    </h3>
    @if (MaterialsOpen)
    {
        <table class="table material-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Tokens</th>
                    <th>Added</th>
                    <th>Last edited</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in _types)
                {
                    var inType = DocumentsIn(type.Id);
                    <tr class="table-group"><td colspan="6">@type.Name</td></tr>
                    @if (inType.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">Add materials above</td></tr>
                    }
                    else
                    {
                        foreach (var doc in inType)
                        {
                            @documentRow(doc)
                        }
                    }
                }
            </tbody>
        </table>
    }

    <h3 class="material-heading">
        <button type="button" class="heading-toggle" aria-expanded="@_typesOpen"
                @onclick="() => _typesOpen = !_typesOpen">
            <span class="heading-caret">@(_typesOpen ? "▾" : "▸")</span>Document types
        </button>
    </h3>
    @if (_typesOpen)
    {
        <ul class="type-list">
            @foreach (var type in _types)
            {
                var count = DocumentsIn(type.Id).Count;
                <li>
                    @if (_renameType?.Id == type.Id)
                    {
                        <input @ref="_renameTypeInput" class="material-input type-rename-input" maxlength="200"
                               @bind="_renameTypeValue" @bind:event="oninput"
                               @onkeydown="RenameTypeKeyDownAsync" @onblur="SaveTypeRenameAsync" />
                    }
                    else if (CanEdit && !type.IsFixed)
                    {
                        <button type="button" class="link-button type-list-name" title="Rename"
                                @onclick="() => BeginTypeRename(type)">@type.Name</button>
                    }
                    else
                    {
                        <span class="type-list-name">@type.Name</span>
                    }
                    <span class="text-muted">@(count == 1 ? "1 item" : $"{count} items")</span>
                    @if (CanEdit && !type.IsFixed)
                    {
                        <button class="btn btn-outline btn-sm" disabled="@(_busy || !CanRemove(type))"
                                title="@RemoveHint(type)" @onclick="() => RemoveTypeAsync(type)">Remove</button>
                    }
                </li>
            }
        </ul>
        @if (CanEdit)
        {
            <div class="type-add">
                <input type="text" class="material-input" placeholder="New document type" maxlength="200"
                       @bind="_newTypeName" @bind:event="oninput" @onkeydown="NewTypeKeyDownAsync" />
                <button class="btn btn-outline btn-sm" @onclick="AddTypeAsync"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_newTypeName))">Add type</button>
            </div>
        }
    }
}

@if (_previewDocument is not null)
{
    <div class="modal-backdrop" @onclick="ClosePreview">
        <div class="modal-panel modal-wide" tabindex="-1" @ref="_dialogPanel"
             @onclick:stopPropagation @onkeydown="e => DialogKeyAsync(e, null, ClosePreview)">
            <h2 class="modal-title">@_previewDocument.Name</h2>
            @if (_previewDocument.OriginalFileName is { } original)
            {
                <p class="name-original modal-source">@original</p>
            }
            <div class="preview-text">@_previewDocument.ExtractedText</div>
            <div class="modal-actions">
                @if (CanEdit)
                {
                    <button class="btn btn-primary" @onclick="() => BeginEdit(_previewDocument!)">Edit</button>
                }
                <button class="btn btn-outline" @onclick="ClosePreview">Close</button>
            </div>
        </div>
    </div>
}

@if (_textEditDocument is not null)
{
    <div class="modal-backdrop" @onclick="CloseTextEditor">
        <div class="modal-panel modal-wide" @onclick:stopPropagation
             @onkeydown="e => DialogKeyAsync(e, SaveTextEditAsync, CloseTextEditor)">
            <h2 class="modal-title">Edit document</h2>
            <div class="form-field">
                <label for="doc-title">Title</label>
                <input id="doc-title" type="text" maxlength="500" @ref="_textEditTitleInput"
                       @bind="_textEditTitle" @bind:event="oninput"
                       @onkeydown="e => TitleEnterAsync(e, _textEditTextArea)" />
                @if (_textEditDocument.OriginalFileName is { } original)
                {
                    <p class="form-hint">Original file: @original</p>
                }
            </div>
            <div class="form-field">
                <label for="doc-text">Extracted text</label>
                <textarea id="doc-text" rows="20" @ref="_textEditTextArea"
                          style="font-family: ui-monospace, monospace; font-size: 0.85rem;"
                          @bind="_textEditValue" @bind:event="oninput"></textarea>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="SaveTextEditAsync" disabled="@_busy">Save changes</button>
                <button class="btn btn-outline" @onclick="CloseTextEditor">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_historyDocument is not null)
{
    <div class="modal-backdrop" @onclick="CloseTextHistory">
        <div class="modal-panel modal-wide" tabindex="-1" @ref="_dialogPanel"
             @onclick:stopPropagation @onkeydown="e => DialogKeyAsync(e, null, CloseTextHistory)">
            <h2 class="modal-title">History: @_historyDocument.Name</h2>
            @if (_historyVersions is null)
            {
                <p class="text-muted">Loading…</p>
            }
            else if (_historyVersions.Count == 0)
            {
                <p class="text-muted">No versions yet.</p>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CloseTextHistory">Close</button>
                </div>
            }
            else if (_viewHistoryVersion is not null)
            {
                <p class="text-muted">
                    @_viewHistoryVersion.Origin · @_viewHistoryVersion.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")
                    · @(_viewHistoryVersion.CreatedBy?.DisplayName ?? "unknown")
                </p>
                <div class="preview-text">@_viewHistoryVersion.Text</div>
                <div class="modal-actions">
                    @if (CanEdit)
                    {
                        <button class="btn btn-primary" @onclick="() => RestoreTextVersionAsync(_viewHistoryVersion.Id)"
                                disabled="@_busy">Restore this version</button>
                    }
                    <button class="btn btn-outline" @onclick="() => _viewHistoryVersion = null">Back to list</button>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>When</th><th>Origin</th><th>By</th><th>Tokens</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var version in _historyVersions)
                        {
                            <tr>
                                <td>@version.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                <td><span class="badge badge-role">@OriginLabel(version.Origin)</span></td>
                                <td>@(version.CreatedBy?.DisplayName ?? "–")</td>
                                <td class="text-muted" title="@TokenTitle(VersionTokens(version))">@FormatTokens(VersionTokens(version))</td>
                                <td style="text-align: right;">
                                    <button class="btn btn-outline btn-sm" @onclick="() => _viewHistoryVersion = version">View</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CloseTextHistory">Close</button>
                </div>
            }
        </div>
    </div>
}

@if (_noteEditorOpen)
{
    <div class="modal-backdrop" @onclick="CloseNoteEditor">
        <div class="modal-panel modal-wide" @onclick:stopPropagation
             @onkeydown="e => DialogKeyAsync(e, SaveNoteAsync, CloseNoteEditor)">
            <h2 class="modal-title">@(_editingNoteId is null ? "New note" : "Edit note")</h2>
            <div class="form-field">
                <label for="note-title">Title</label>
                <input id="note-title" type="text" @ref="_noteTitleInput"
                       @bind="_noteTitle" @bind:event="oninput"
                       @onkeydown="e => TitleEnterAsync(e, _noteTextArea)" />
            </div>
            <div class="form-field">
                <label for="note-text">Note</label>
                <textarea id="note-text" rows="10" @ref="_noteTextArea"
                          @bind="_noteText" @bind:event="oninput"></textarea>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="SaveNoteAsync" disabled="@_busy">Save note</button>
                <button class="btn btn-outline" @onclick="CloseNoteEditor">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_deleteDocument is not null)
{
    <div class="modal-backdrop" @onclick="CloseDelete">
        <div class="modal-panel" tabindex="-1" @ref="_dialogPanel"
             @onclick:stopPropagation @onkeydown="e => DialogKeyAsync(e, null, CloseDelete)">
            <h2 class="modal-title">Delete @(_deleteDocument.Kind == DocumentKind.Note ? "note" : "document")</h2>
            <p>
                Delete <strong>@_deleteDocument.Name</strong>? It is removed from the proposal's source
                material, along with its text history.
            </p>
            <div class="modal-actions">
                <button class="btn btn-danger" @onclick="DeleteDocumentAsync" disabled="@_busy">Delete</button>
                <button class="btn btn-outline" @onclick="CloseDelete">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ProposalId { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    private const long MaxFileSize = 100 * 1024 * 1024;

    private string _acceptTypes = "";
    private List<Document>? _documents;
    private List<DocumentType> _types = [];
    private Document? _previewDocument;
    private Document? _deleteDocument;
    private bool _uploading;
    private bool _busy;

    /// <summary>The list opens itself once there is material to show; a click then wins over that.
    /// A reader or oversight-only super admin has no upload control to tell them the list is just
    /// empty, so for them it opens regardless - collapsed and empty would look like a bug, not a
    /// fact about the proposal. Document types are settings, not daily work, so they stay closed
    /// until asked for.</summary>
    private bool? _materialsOpen;
    private bool _typesOpen;

    private bool MaterialsOpen => _materialsOpen ?? (!CanEdit || _documents is { Count: > 0 });
    private string? _error;

    /// <summary>Documents uploaded since this page was entered, so they can be flagged "New".</summary>
    private readonly HashSet<Guid> _newDocumentIds = [];

    /// <summary>Type new material is filed under; sticky, so a run of uploads stays in one category.</summary>
    private Guid _uploadTypeId;
    private Guid _noteTypeId;
    private string _newTypeName = "";

    private Document? _typeEditDocument;
    private ElementReference _typeSelect;
    private bool _focusTypeSelect;

    private Document? _renameDocument;
    private string _renameValue = "";
    private ElementReference _renameInput;
    private bool _focusRenameInput;

    private DocumentType? _renameType;
    private string _renameTypeValue = "";
    private ElementReference _renameTypeInput;
    private bool _focusRenameTypeInput;

    private bool _noteEditorOpen;
    private Guid? _editingNoteId;
    private string _noteTitle = "";
    private string _noteText = "";
    private ElementReference _noteTitleInput;
    private ElementReference _noteTextArea;
    private bool _focusNoteTitle;

    private Document? _textEditDocument;
    private string _textEditTitle = "";
    private string _textEditValue = "";
    private ElementReference _textEditTitleInput;
    private ElementReference _textEditTextArea;
    private bool _focusTextEditTitle;

    /// <summary>The panel of whichever read-only dialog is open. Only one of preview, history and
    /// delete can be, so they share the reference; it exists so Escape reaches a dialog the user
    /// has not clicked into — a keydown handler only fires for focus inside the panel.</summary>
    private ElementReference _dialogPanel;
    private bool _focusDialogPanel;

    private Document? _historyDocument;
    private List<DocumentVersion>? _historyVersions;
    private DocumentVersion? _viewHistoryVersion;

    protected override void OnInitialized()
        => _acceptTypes = string.Join(",", TextExtractor.SupportedExtensions.Order());

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The row's type cell turns into a select on click; drop its list open on the same click
        // rather than making the user click the select as well.
        if (_focusTypeSelect && _typeEditDocument is not null)
        {
            _focusTypeSelect = false;
            await JS.InvokeVoidAsync("sagaSelect.openPicker", _typeSelect);
        }

        // Same for the name cell, which turns into a text box.
        if (_focusRenameInput && _renameDocument is not null)
        {
            _focusRenameInput = false;
            await _renameInput.FocusAsync();
        }

        // And for a custom type's name in the list below the table.
        if (_focusRenameTypeInput && _renameType is not null)
        {
            _focusRenameTypeInput = false;
            await _renameTypeInput.FocusAsync();
        }

        // A dialog opens with the caret already in its first field, so it can be filled in without
        // reaching for the mouse. The plain autofocus attribute is no use here: the markup is
        // patched into a page the browser parsed long ago.
        if (_focusNoteTitle && _noteEditorOpen)
        {
            _focusNoteTitle = false;
            await _noteTitleInput.FocusAsync();
        }

        if (_focusTextEditTitle && _textEditDocument is not null)
        {
            _focusTextEditTitle = false;
            await _textEditTitleInput.FocusAsync();
        }

        if (_focusDialogPanel)
        {
            _focusDialogPanel = false;
            await _dialogPanel.FocusAsync();
        }
    }

    /// <summary>Windows dialog keys: Escape backs out, Ctrl+Enter commits. Handled on the panel so
    /// they work from any field inside it.</summary>
    private Task DialogKeyAsync(KeyboardEventArgs e, Func<Task>? save, Action close)
    {
        if (e.Key == "Escape")
        {
            close();
            return Task.CompletedTask;
        }

        if (save is not null && e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && !_busy)
        {
            return save();
        }

        return Task.CompletedTask;
    }

    /// <summary>Enter in a dialog's title box moves on to the body rather than doing nothing.</summary>
    private async Task TitleEnterAsync(KeyboardEventArgs e, ElementReference body)
    {
        if (e.Key == "Enter" && !e.CtrlKey && !e.MetaKey && !e.ShiftKey && !e.AltKey)
        {
            await body.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        var user = await CurrentUser.GetAsync();
        _types = await Documents.GetTypesAsync(ProposalId, user.Id);
        _documents = await Documents.GetForProposalAsync(ProposalId, user.Id);
        // The two pickers start on different categories because that is what each is nearly
        // always used for: files arrive from the client, notes are written by us.
        _uploadTypeId = KeepOrDefault(_uploadTypeId, DocumentType.ClientMaterialName);
        _noteTypeId = KeepOrDefault(_noteTypeId, DocumentType.MannazMaterialName);
    }

    /// <summary>Holds a picked type across reloads, falling back to the named seeded category
    /// and, if a proposal no longer has it, to the first (highest-priority) type.</summary>
    private Guid KeepOrDefault(Guid selected, string preferredName)
    {
        if (_types.Any(t => t.Id == selected))
            return selected;

        var preferred = _types.FirstOrDefault(t => string.Equals(t.Name, preferredName, StringComparison.OrdinalIgnoreCase));
        return preferred?.Id ?? _types.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private List<Document> DocumentsIn(Guid typeId)
        => _documents?.Where(d => d.DocumentTypeId == typeId).ToList() ?? [];

    private string TypeName(Document document)
        => _types.FirstOrDefault(t => t.Id == document.DocumentTypeId)?.Name ?? "–";

    /// <summary>The two standard categories have no Remove button at all, so this only covers
    /// types added to this proposal.</summary>
    private bool CanRemove(DocumentType type)
        => _types.Count > 1 && DocumentsIn(type.Id).Count == 0;

    private string? RemoveHint(DocumentType type)
    {
        if (DocumentsIn(type.Id).Count > 0)
            return "Move or delete this type's material first.";
        return _types.Count > 1 ? null : "A proposal needs at least one document type.";
    }

    /// <summary>The file a renamed upload came from, or null when the name is still the file's own.</summary>
    private static string? RenamedFrom(Document document)
        => document.OriginalFileName is { } original && original != document.Name ? original : null;

    private void BeginRename(Document document)
    {
        _renameDocument = document;
        _renameValue = document.Name;
        _focusRenameInput = true;
    }

    private async Task RenameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SaveRenameAsync();
        else if (e.Key == "Escape")
            _renameDocument = null;
    }

    /// <summary>
    /// Commits the inline rename. Also runs on blur, so it no-ops once the cell is back to
    /// plain text - an Escape or an already-saved Enter must not save a second time.
    /// </summary>
    private async Task SaveRenameAsync()
    {
        if (_renameDocument is not { } document) return;
        _renameDocument = null;
        if (string.IsNullOrWhiteSpace(_renameValue) || _renameValue.Trim() == document.Name) return;

        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.RenameAsync(document.Id, user.Id, _renameValue);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void BeginTypeEdit(Document document)
    {
        _typeEditDocument = document;
        _focusTypeSelect = true;
    }

    private async Task ChangeTypeAsync(Document document, Guid typeId)
    {
        _typeEditDocument = null;
        if (document.DocumentTypeId == typeId) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.SetDocumentTypeAsync(document.Id, user.Id, typeId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void BeginTypeRename(DocumentType type)
    {
        _renameType = type;
        _renameTypeValue = type.Name;
        _focusRenameTypeInput = true;
    }

    private async Task RenameTypeKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SaveTypeRenameAsync();
        else if (e.Key == "Escape")
            _renameType = null;
    }

    /// <summary>Commits the inline type rename; like the document one it also runs on blur, so
    /// it no-ops once the row is back to plain text.</summary>
    private async Task SaveTypeRenameAsync()
    {
        if (_renameType is not { } type) return;
        _renameType = null;
        if (string.IsNullOrWhiteSpace(_renameTypeValue) || _renameTypeValue.Trim() == type.Name) return;

        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.RenameTypeAsync(type.Id, user.Id, _renameTypeValue);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTypeName)) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.AddTypeAsync(ProposalId, user.Id, _newTypeName);
            _newTypeName = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NewTypeKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTypeAsync();
    }

    private async Task RemoveTypeAsync(DocumentType type)
    {
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.RemoveTypeAsync(type.Id, user.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        _uploading = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            var beforeIds = _documents?.Select(d => d.Id).ToHashSet() ?? [];
            foreach (var file in e.GetMultipleFiles())
            {
                await using var stream = file.OpenReadStream(MaxFileSize);
                await Documents.UploadAsync(ProposalId, user.Id, file.Name, stream, _uploadTypeId);
            }
            await LoadAsync();
            foreach (var doc in _documents ?? [])
            {
                if (!beforeIds.Contains(doc.Id))
                    _newDocumentIds.Add(doc.Id);
            }
            _materialsOpen = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private void OpenPreview(Document document)
    {
        _previewDocument = document;
        _focusDialogPanel = true;
    }

    private void ClosePreview() => _previewDocument = null;

    private void OpenDelete(Document document)
    {
        _deleteDocument = document;
        _focusDialogPanel = true;
    }

    private void CloseDelete() => _deleteDocument = null;

    /// <summary>Notes are edited as title + text; uploads as their extracted text.</summary>
    private void BeginEdit(Document document)
    {
        _previewDocument = null;
        if (document.Kind == DocumentKind.Note)
        {
            EditNote(document);
            return;
        }
        _textEditDocument = document;
        _textEditTitle = document.Name;
        _textEditValue = document.ExtractedText;
        _focusTextEditTitle = true;
    }

    private void CloseTextEditor() => _textEditDocument = null;

    private async Task SaveTextEditAsync()
    {
        if (_textEditDocument is null) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            if (!string.IsNullOrWhiteSpace(_textEditTitle))
                await Documents.RenameAsync(_textEditDocument.Id, user.Id, _textEditTitle);
            await Documents.UpdateExtractedTextAsync(_textEditDocument.Id, user.Id, _textEditValue);
            _textEditDocument = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenTextHistoryAsync(Document document)
    {
        _historyDocument = document;
        _historyVersions = null;
        _viewHistoryVersion = null;
        _focusDialogPanel = true;
        var user = await CurrentUser.GetAsync();
        _historyVersions = await Documents.GetVersionsAsync(document.Id, user.Id);
    }

    private void CloseTextHistory()
    {
        _historyDocument = null;
        _historyVersions = null;
        _viewHistoryVersion = null;
    }

    private async Task RestoreTextVersionAsync(Guid versionId)
    {
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.RestoreVersionAsync(versionId, user.Id);
            CloseTextHistory();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string OriginLabel(VersionOrigin origin) => origin switch
    {
        VersionOrigin.Generated => _historyDocument?.Kind == DocumentKind.Note ? "Created" : "Extracted",
        VersionOrigin.Edited => "Edited",
        _ => "Restored",
    };

    private void NewNote()
    {
        _editingNoteId = null;
        _noteTitle = "";
        _noteText = "";
        _noteEditorOpen = true;
        _focusNoteTitle = true;
    }

    private void EditNote(Document note)
    {
        _editingNoteId = note.Id;
        _noteTitle = note.Name;
        _noteText = note.ExtractedText;
        _noteEditorOpen = true;
        _focusNoteTitle = true;
    }

    private void CloseNoteEditor() => _noteEditorOpen = false;

    private async Task SaveNoteAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            if (_editingNoteId is null)
                await Documents.AddNoteAsync(ProposalId, user.Id, _noteTitle, _noteText, _noteTypeId);
            else
                await Documents.UpdateNoteAsync(_editingNoteId.Value, user.Id, _noteTitle, _noteText);
            _noteEditorOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteDocumentAsync()
    {
        if (_deleteDocument is null) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.DeleteAsync(_deleteDocument.Id, user.Id);
            _deleteDocument = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static int VersionTokens(DocumentVersion version)
        => version.TokenCount ?? TokenCounter.Count(version.Text);

    /// <summary>Compact token counts: 740, 1.5k, 74k, 1.5M. The exact figure is the cell's title.</summary>
    private static string FormatTokens(int tokens)
        => tokens switch
        {
            0 => "no text",
            < 1_000 => tokens.ToString(),
            < 10_000 => $"{tokens / 1_000d:0.#}k",
            < 1_000_000 => $"{tokens / 1_000d:0}k",
            < 10_000_000 => $"{tokens / 1_000_000d:0.#}M",
            _ => $"{tokens / 1_000_000d:0}M",
        };

    private static string? TokenTitle(int tokens)
        => tokens == 0 ? null : $"{tokens:N0} tokens";
}
