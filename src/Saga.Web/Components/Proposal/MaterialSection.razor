@using Saga.Core.Abstractions
@inject DocumentService Documents
@inject CurrentUserService CurrentUser
@inject IDocumentTextExtractor TextExtractor

<h2>Materials</h2>

@if (_error is not null)
{
    <p class="error-text">@_error</p>
}

@if (CanEdit)
{
    <h3 class="material-heading">Upload files</h3>
    <div class="type-picker">
        <label for="upload-type">Document type</label>
        <select id="upload-type" @bind="_uploadTypeId" disabled="@_uploading">
            @foreach (var type in _types)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </select>
    </div>
    <label class="upload-area">
        <InputFile OnChange="UploadAsync" multiple accept="@_acceptTypes" disabled="@_uploading" />
        @if (_uploading)
        {
            <span>Uploading and extracting text…</span>
        }
        else
        {
            <span><strong>Choose files</strong> or drop them here — PDF, Word, PowerPoint, Excel, images, text</span>
        }
    </label>

    <h3 class="material-heading">Add note</h3>
    <div class="type-picker">
        <label for="note-type">Document type</label>
        <select id="note-type" @bind="_noteTypeId">
            @foreach (var type in _types)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </select>
    </div>
    <button type="button" class="upload-area" @onclick="NewNote">
        <span><strong>Add note</strong></span>
    </button>
}

@{
    RenderFragment<Document> documentRow = doc =>
        @<tr>
            <td>
                <button type="button" class="link-button" @onclick="() => _previewDocument = doc">@doc.Name</button>
                @if (doc.Kind == DocumentKind.Note)
                {
                    <span class="badge badge-role">Note</span>
                }
            </td>
            <td>
                @if (!CanEdit)
                {
                    <span class="text-muted">@TypeName(doc)</span>
                }
                else if (_typeEditDocument?.Id == doc.Id)
                {
                    <select @ref="_typeSelect" class="type-select"
                            @bind:get="doc.DocumentTypeId"
                            @bind:set="value => ChangeTypeAsync(doc, value)"
                            @onblur="() => _typeEditDocument = null">
                        @foreach (var type in _types)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                }
                else
                {
                    <button type="button" class="link-button type-cell" @onclick="() => BeginTypeEdit(doc)">
                        @TypeName(doc)<span class="type-caret">▾</span>
                    </button>
                }
            </td>
            <td class="text-muted">@FormatLength(doc.ExtractedText)</td>
            <td class="text-muted">@doc.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
            <td class="text-muted">@(doc.UpdatedAt > doc.CreatedAt ? doc.UpdatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm") : "—")</td>
            <td style="text-align: right; white-space: nowrap;">
                @if (CanEdit)
                {
                    <button class="btn btn-outline btn-sm" @onclick="() => BeginEdit(doc)">Edit</button>
                }
                <button class="btn btn-outline btn-sm" @onclick="() => OpenTextHistoryAsync(doc)">History</button>
                @if (CanEdit)
                {
                    <button class="btn btn-outline btn-sm" @onclick="() => _deleteDocument = doc">Delete</button>
                }
            </td>
        </tr>;
}

@if (_documents is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <h3 class="material-heading">Materials</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Length</th>
                <th>Added</th>
                <th>Last edited</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var type in _types)
            {
                var inType = DocumentsIn(type.Id);
                <tr class="table-group"><td colspan="6">@type.Name</td></tr>
                @if (inType.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">Nothing filed here yet</td></tr>
                }
                else
                {
                    foreach (var doc in inType)
                    {
                        @documentRow(doc)
                    }
                }
            }
        </tbody>
    </table>

    <h3 class="material-heading">Document types</h3>
    <p class="text-muted">
        Material is filed under these categories. The order is also their priority when the AI
        resolves a conflict between two documents, so the first type outranks the ones below it.
    </p>
    <ul class="type-list">
        @foreach (var type in _types)
        {
            var count = DocumentsIn(type.Id).Count;
            <li>
                <span class="type-list-name">@type.Name</span>
                <span class="text-muted">@(count == 1 ? "1 item" : $"{count} items")</span>
                @if (CanEdit)
                {
                    <button class="btn btn-outline btn-sm" disabled="@(_busy || !CanRemove(type))"
                            title="@RemoveHint(type)" @onclick="() => RemoveTypeAsync(type)">Remove</button>
                }
            </li>
        }
    </ul>
    @if (CanEdit)
    {
        <div class="type-add">
            <input type="text" placeholder="New document type" maxlength="200"
                   @bind="_newTypeName" @bind:event="oninput" @onkeydown="NewTypeKeyDownAsync" />
            <button class="btn btn-outline btn-sm" @onclick="AddTypeAsync"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_newTypeName))">Add type</button>
        </div>
    }
}

@if (_previewDocument is not null)
{
    <div class="modal-backdrop" @onclick="() => _previewDocument = null">
        <div class="modal-panel modal-wide" @onclick:stopPropagation>
            <h2 class="modal-title">@_previewDocument.Name</h2>
            <div class="preview-text">@_previewDocument.ExtractedText</div>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="() => _previewDocument = null">Close</button>
                @if (CanEdit)
                {
                    <button class="btn btn-primary" @onclick="() => BeginEdit(_previewDocument!)">Edit</button>
                }
            </div>
        </div>
    </div>
}

@if (_textEditDocument is not null)
{
    <div class="modal-backdrop" @onclick="CloseTextEditor">
        <div class="modal-panel modal-wide" @onclick:stopPropagation>
            <h2 class="modal-title">Edit extracted text — @_textEditDocument.Name</h2>
            <div class="form-field">
                <textarea rows="22" style="width: 100%; font-family: ui-monospace, monospace; font-size: 0.85rem;"
                          @bind="_textEditValue"></textarea>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="CloseTextEditor">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveTextEditAsync" disabled="@_busy">Save text</button>
            </div>
        </div>
    </div>
}

@if (_historyDocument is not null)
{
    <div class="modal-backdrop" @onclick="CloseTextHistory">
        <div class="modal-panel modal-wide" @onclick:stopPropagation>
            <h2 class="modal-title">History — @_historyDocument.Name</h2>
            @if (_historyVersions is null)
            {
                <p class="text-muted">Loading…</p>
            }
            else if (_historyVersions.Count == 0)
            {
                <p class="text-muted">No versions yet.</p>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CloseTextHistory">Close</button>
                </div>
            }
            else if (_viewHistoryVersion is not null)
            {
                <p class="text-muted">
                    @_viewHistoryVersion.Origin · @_viewHistoryVersion.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")
                    · @(_viewHistoryVersion.CreatedBy?.DisplayName ?? "unknown")
                </p>
                <div class="preview-text">@_viewHistoryVersion.Text</div>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="() => _viewHistoryVersion = null">Back to list</button>
                    @if (CanEdit)
                    {
                        <button class="btn btn-primary" @onclick="() => RestoreTextVersionAsync(_viewHistoryVersion.Id)"
                                disabled="@_busy">Restore this version</button>
                    }
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr><th>When</th><th>Origin</th><th>By</th><th>Length</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var version in _historyVersions)
                        {
                            <tr>
                                <td>@version.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                <td><span class="badge badge-role">@OriginLabel(version.Origin)</span></td>
                                <td>@(version.CreatedBy?.DisplayName ?? "—")</td>
                                <td class="text-muted">@FormatLength(version.Text)</td>
                                <td style="text-align: right;">
                                    <button class="btn btn-outline btn-sm" @onclick="() => _viewHistoryVersion = version">View</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="modal-actions">
                    <button class="btn btn-outline" @onclick="CloseTextHistory">Close</button>
                </div>
            }
        </div>
    </div>
}

@if (_noteEditorOpen)
{
    <div class="modal-backdrop" @onclick="CloseNoteEditor">
        <div class="modal-panel modal-wide" @onclick:stopPropagation>
            <h2 class="modal-title">@(_editingNoteId is null ? "New note" : "Edit note")</h2>
            <div class="form-field">
                <label for="note-title">Title</label>
                <input id="note-title" type="text" @bind="_noteTitle" />
            </div>
            <div class="form-field">
                <label for="note-text">Note</label>
                <textarea id="note-text" rows="10" @bind="_noteText"></textarea>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="CloseNoteEditor">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveNoteAsync" disabled="@_busy">Save note</button>
            </div>
        </div>
    </div>
}

@if (_deleteDocument is not null)
{
    <div class="modal-backdrop" @onclick="() => _deleteDocument = null">
        <div class="modal-panel" @onclick:stopPropagation>
            <h2 class="modal-title">Delete @(_deleteDocument.Kind == DocumentKind.Note ? "note" : "document")</h2>
            <p>
                Delete <strong>@_deleteDocument.Name</strong>? It is removed from the proposal's source
                material, along with its text history.
            </p>
            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="() => _deleteDocument = null">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteDocumentAsync" disabled="@_busy">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ProposalId { get; set; }
    [Parameter] public bool CanEdit { get; set; }

    private const long MaxFileSize = 100 * 1024 * 1024;

    private string _acceptTypes = "";
    private List<Document>? _documents;
    private List<DocumentType> _types = [];
    private Document? _previewDocument;
    private Document? _deleteDocument;
    private bool _uploading;
    private bool _busy;
    private string? _error;

    /// <summary>Type new material is filed under; sticky, so a run of uploads stays in one category.</summary>
    private Guid _uploadTypeId;
    private Guid _noteTypeId;
    private string _newTypeName = "";

    private Document? _typeEditDocument;
    private ElementReference _typeSelect;
    private bool _focusTypeSelect;

    private bool _noteEditorOpen;
    private Guid? _editingNoteId;
    private string _noteTitle = "";
    private string _noteText = "";

    private Document? _textEditDocument;
    private string _textEditValue = "";
    private Document? _historyDocument;
    private List<DocumentVersion>? _historyVersions;
    private DocumentVersion? _viewHistoryVersion;

    protected override void OnInitialized()
        => _acceptTypes = string.Join(",", TextExtractor.SupportedExtensions.Order());

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The row's type cell turns into a select on click, so move focus onto it.
        if (_focusTypeSelect && _typeEditDocument is not null)
        {
            _focusTypeSelect = false;
            await _typeSelect.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        var user = await CurrentUser.GetAsync();
        _types = await Documents.GetTypesAsync(ProposalId, user.Id);
        _documents = await Documents.GetForProposalAsync(ProposalId, user.Id);
        _uploadTypeId = KeepOrDefault(_uploadTypeId);
        _noteTypeId = KeepOrDefault(_noteTypeId);
    }

    /// <summary>Holds a picked type across reloads, falling back to the first (highest-priority) one.</summary>
    private Guid KeepOrDefault(Guid selected)
        => _types.Any(t => t.Id == selected) ? selected : _types.FirstOrDefault()?.Id ?? Guid.Empty;

    private List<Document> DocumentsIn(Guid typeId)
        => _documents?.Where(d => d.DocumentTypeId == typeId).ToList() ?? [];

    private string TypeName(Document document)
        => _types.FirstOrDefault(t => t.Id == document.DocumentTypeId)?.Name ?? "—";

    private bool CanRemove(DocumentType type)
        => _types.Count > 1 && DocumentsIn(type.Id).Count == 0;

    private string? RemoveHint(DocumentType type)
    {
        if (DocumentsIn(type.Id).Count > 0)
            return "Move or delete this type's material first.";
        return _types.Count > 1 ? null : "A proposal needs at least one document type.";
    }

    private void BeginTypeEdit(Document document)
    {
        _typeEditDocument = document;
        _focusTypeSelect = true;
    }

    private async Task ChangeTypeAsync(Document document, Guid typeId)
    {
        _typeEditDocument = null;
        if (document.DocumentTypeId == typeId) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.SetDocumentTypeAsync(document.Id, user.Id, typeId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddTypeAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTypeName)) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.AddTypeAsync(ProposalId, user.Id, _newTypeName);
            _newTypeName = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NewTypeKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTypeAsync();
    }

    private async Task RemoveTypeAsync(DocumentType type)
    {
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.RemoveTypeAsync(type.Id, user.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        _uploading = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            foreach (var file in e.GetMultipleFiles())
            {
                await using var stream = file.OpenReadStream(MaxFileSize);
                await Documents.UploadAsync(ProposalId, user.Id, file.Name, stream, _uploadTypeId);
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    /// <summary>Notes are edited as title + text; uploads as their extracted text.</summary>
    private void BeginEdit(Document document)
    {
        _previewDocument = null;
        if (document.Kind == DocumentKind.Note)
        {
            EditNote(document);
            return;
        }
        _textEditDocument = document;
        _textEditValue = document.ExtractedText;
    }

    private void CloseTextEditor() => _textEditDocument = null;

    private async Task SaveTextEditAsync()
    {
        if (_textEditDocument is null) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.UpdateExtractedTextAsync(_textEditDocument.Id, user.Id, _textEditValue);
            _textEditDocument = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenTextHistoryAsync(Document document)
    {
        _historyDocument = document;
        _historyVersions = null;
        _viewHistoryVersion = null;
        var user = await CurrentUser.GetAsync();
        _historyVersions = await Documents.GetVersionsAsync(document.Id, user.Id);
    }

    private void CloseTextHistory()
    {
        _historyDocument = null;
        _historyVersions = null;
        _viewHistoryVersion = null;
    }

    private async Task RestoreTextVersionAsync(Guid versionId)
    {
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.RestoreVersionAsync(versionId, user.Id);
            CloseTextHistory();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string OriginLabel(VersionOrigin origin) => origin switch
    {
        VersionOrigin.Generated => _historyDocument?.Kind == DocumentKind.Note ? "Created" : "Extracted",
        VersionOrigin.Edited => "Edited",
        _ => "Restored",
    };

    private void NewNote()
    {
        _editingNoteId = null;
        _noteTitle = "";
        _noteText = "";
        _noteEditorOpen = true;
    }

    private void EditNote(Document note)
    {
        _editingNoteId = note.Id;
        _noteTitle = note.Name;
        _noteText = note.ExtractedText;
        _noteEditorOpen = true;
    }

    private void CloseNoteEditor() => _noteEditorOpen = false;

    private async Task SaveNoteAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            if (_editingNoteId is null)
                await Documents.AddNoteAsync(ProposalId, user.Id, _noteTitle, _noteText, _noteTypeId);
            else
                await Documents.UpdateNoteAsync(_editingNoteId.Value, user.Id, _noteTitle, _noteText);
            _noteEditorOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteDocumentAsync()
    {
        if (_deleteDocument is null) return;
        _busy = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            await Documents.DeleteAsync(_deleteDocument.Id, user.Id);
            _deleteDocument = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Compact character counts: 740, 1.5k, 74k, 1.5M.</summary>
    private static string FormatLength(string text)
        => text.Length switch
        {
            0 => "no text",
            < 1_000 => text.Length.ToString(),
            < 10_000 => $"{text.Length / 1_000d:0.#}k",
            < 1_000_000 => $"{text.Length / 1_000d:0}k",
            < 10_000_000 => $"{text.Length / 1_000_000d:0.#}M",
            _ => $"{text.Length / 1_000_000d:0}M",
        };
}
