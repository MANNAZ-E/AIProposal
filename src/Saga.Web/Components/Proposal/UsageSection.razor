@using Saga.Core.Abstractions
@inject AiUsageService Usage
@inject CurrentUserService CurrentUser

<h2>Usage</h2>
<p class="text-muted">
    Every AI call this proposal has made, grouped by service and model. Costs are estimates from
    the rates in configuration, frozen at the time of each call — the Azure invoice is the source
    of truth.
</p>

@if (_error is not null)
{
    <div class="card danger-zone"><p style="margin: 0;">@_error</p></div>
}
else if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_usage is null || _usage.Totals.Calls == 0)
{
    <div class="empty-state"><p>No AI calls recorded for this proposal yet.</p></div>
}
else
{
    <div class="card" style="max-width: 760px;">
        <div style="display: flex; gap: 2.5rem; flex-wrap: wrap;">
            <div>
                <div class="text-muted" style="font-size: 0.82rem;">Estimated spend</div>
                <div style="font-size: 1.6rem; font-weight: 600;">@Cost(_usage.Totals.CostUsd)</div>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.82rem;">Calls</div>
                <div style="font-size: 1.6rem; font-weight: 600;">@_usage.Totals.Calls.ToString("N0")</div>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.82rem;">Tokens in / out</div>
                <div style="font-size: 1.6rem; font-weight: 600;">
                    @_usage.Totals.InputTokens.ToString("N0") / @_usage.Totals.OutputTokens.ToString("N0")
                </div>
            </div>
            @if (_usage.Totals.PageCount > 0)
            {
                <div>
                    <div class="text-muted" style="font-size: 0.82rem;">Pages analysed</div>
                    <div style="font-size: 1.6rem; font-weight: 600;">@_usage.Totals.PageCount.ToString("N0")</div>
                </div>
            }
        </div>
    </div>

    <div class="section-title">By service and model</div>
    <div class="req-table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Model</th>
                    <th style="text-align: right;">Calls</th>
                    <th style="text-align: right;">Tokens in</th>
                    <th style="text-align: right;">Tokens out</th>
                    <th style="text-align: right;">Pages</th>
                    <th style="text-align: right;">Est. cost (@Money.Currency(_rate))</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in _usage.Breakdown.GroupBy(b => b.Service))
                {
                    var groupTotal = AiUsageService.Sum(group.Select(g => g.Totals));
                    <tr class="table-group">
                        <td colspan="2"><strong>@ServiceName(group.Key)</strong></td>
                        <td style="text-align: right;">@groupTotal.Calls.ToString("N0")</td>
                        <td style="text-align: right;">@groupTotal.InputTokens.ToString("N0")</td>
                        <td style="text-align: right;">@groupTotal.OutputTokens.ToString("N0")</td>
                        <td style="text-align: right;">@(groupTotal.PageCount > 0 ? groupTotal.PageCount.ToString("N0") : "—")</td>
                        <td style="text-align: right;"><strong>@Cost(groupTotal.CostUsd)</strong></td>
                    </tr>
                    @foreach (var row in group)
                    {
                        <tr>
                            <td></td>
                            <td>@row.Model</td>
                            <td style="text-align: right;">@row.Totals.Calls.ToString("N0")</td>
                            <td style="text-align: right;">@row.Totals.InputTokens.ToString("N0")</td>
                            <td style="text-align: right;">@row.Totals.OutputTokens.ToString("N0")</td>
                            <td style="text-align: right;">@(row.Totals.PageCount > 0 ? row.Totals.PageCount.ToString("N0") : "—")</td>
                            <td style="text-align: right;">@Cost(row.Totals.CostUsd)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="section-title">
        Call log
        <button class="btn btn-outline btn-sm" style="margin-left: 0.75rem;"
                @onclick="() => _showCalls = !_showCalls">
            @(_showCalls ? "Hide" : "Show") @_calls.Count calls
        </button>
    </div>
    @if (_showCalls)
    {
        <div class="req-table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Operation</th>
                        <th>Detail</th>
                        <th>Model</th>
                        <th>User</th>
                        <th style="text-align: right;">In / out</th>
                        <th style="text-align: right;">Pages</th>
                        <th style="text-align: right;">Cost</th>
                        <th>Outcome</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var call in _calls)
                    {
                        <tr class="row-link" @onclick="() => OpenCallAsync(call.Id)">
                            <td class="text-muted">@call.StartedAt.ToLocalTime().ToString("dd MMM HH:mm:ss")</td>
                            <td>@OperationName(call.Operation)</td>
                            <td class="text-muted">@call.Label</td>
                            <td>@call.Model</td>
                            <td class="text-muted">@(call.UserName ?? "System")</td>
                            <td style="text-align: right;">
                                @(call.InputTokens > 0 || call.OutputTokens > 0
                                    ? $"{call.InputTokens:N0} / {call.OutputTokens:N0}"
                                    : "—")
                            </td>
                            <td style="text-align: right;">@(call.PageCount > 0 ? call.PageCount.ToString("N0") : "—")</td>
                            <td style="text-align: right;">@Cost(call.CostUsd)</td>
                            <td><span class="badge @OutcomeClass(call.Outcome)">@call.Outcome</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_detail is not null)
{
    <div class="modal-backdrop" @onclick="() => _detail = null">
        <div class="modal-panel modal-wide" @onclick:stopPropagation>
            <h2 class="modal-title">@OperationName(_detail.Call.Operation) — @_detail.Call.Model</h2>
            <p class="text-muted" style="margin-top: -0.5rem;">
                @_detail.Call.StartedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss") ·
                @(_detail.Call.UserName ?? "System") ·
                @_detail.Call.Duration.TotalSeconds.ToString("N1") s ·
                @Cost(_detail.Call.CostUsd)
                @if (_detail.Call.Label is not null)
                {
                    <text> · @_detail.Call.Label</text>
                }
            </p>

            @if (_detail.Call.ErrorMessage is not null)
            {
                <div class="section-title">Error</div>
                <div class="preview-text">@_detail.Call.ErrorMessage</div>
            }
            @if (_detail.InstructionText is not null)
            {
                <div class="section-title">Instruction</div>
                <div class="preview-text">@_detail.InstructionText</div>
            }

            <div class="section-title">Request</div>
            <div class="preview-text">@(_detail.RequestText ?? "(not captured)")</div>

            <div class="section-title">Response</div>
            <div class="preview-text">@(_detail.ResponseText ?? "(not captured)")</div>

            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="() => _detail = null">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProposalId { get; set; }

    private ProposalUsage? _usage;
    private List<AiUsageCall> _calls = [];
    private AiUsageCallDetail? _detail;
    private decimal _rate;
    private bool _loading = true;
    private bool _showCalls;
    private string? _error;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            _rate = Usage.UsdToDkk;
            _usage = await Usage.GetProposalUsageAsync(ProposalId, user.Id);
            _calls = await Usage.GetProposalCallsAsync(ProposalId, user.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCallAsync(Guid recordId)
    {
        var user = await CurrentUser.GetAsync();
        _detail = await Usage.GetCallDetailAsync(recordId, user.Id);
    }

    private string Cost(decimal usd) => Money.Display(usd, _rate);

    private static string ServiceName(AiServiceKind service) => service switch
    {
        AiServiceKind.AzureOpenAI => "Azure OpenAI",
        AiServiceKind.ContentUnderstanding => "Azure Content Understanding",
        _ => service.ToString(),
    };

    private static string OperationName(AiOperation operation) => operation switch
    {
        AiOperation.GenerateArtifact => "Generate",
        AiOperation.GenerateContentUnit => "Generate content unit",
        AiOperation.Chat => "Chat",
        AiOperation.ReviewDraft => "Draft review",
        AiOperation.ReviewProposal => "Proposal review",
        AiOperation.ExtractRequirements => "Extract requirements",
        AiOperation.CondenseDocument => "Condense document",
        AiOperation.ExtractDocument => "Extract document",
        _ => operation.ToString(),
    };

    private static string OutcomeClass(GenerationOutcome outcome) => outcome switch
    {
        GenerationOutcome.Succeeded => "badge-ok",
        GenerationOutcome.Failed => "badge-missing",
        _ => "badge-stale",
    };
}
