@using Saga.Core.Abstractions
@inject AiUsageService Usage
@inject CurrentUserService CurrentUser

<h2 class="section-heading">Usage</h2>

@if (_error is not null)
{
    <div class="card danger-zone"><p style="margin: 0;">@_error</p></div>
}
else if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_usage is null || _usage.Totals.Calls == 0)
{
    <div class="empty-state"><p>No AI calls recorded for this proposal yet.</p></div>
}
else
{
    <div class="card" style="max-width: 980px;">
        <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
            <div>
                <div class="text-muted" style="font-size: 0.82rem;">Estimated spend</div>
                <div style="font-size: 1.6rem; font-weight: 600;">@Cost(_usage.Totals.CostUsd)</div>
            </div>
            <div>
                <div class="text-muted" style="font-size: 0.82rem;">Calls</div>
                <div style="font-size: 1.6rem; font-weight: 600;">@_usage.Totals.Calls.ToString("N0")</div>
            </div>
            @* Each unit only appears where it was actually billed: a proposal whose only spend is
               extraction has no tokens to report, and one that was never uploaded to has no pages. *@
            @if (_usage.Totals.InputTokens > 0 || _usage.Totals.OutputTokens > 0)
            {
                <div>
                    <div class="text-muted" style="font-size: 0.82rem;">Tokens in</div>
                    <div style="font-size: 1.6rem; font-weight: 600;">@_usage.Totals.InputTokens.ToString("N0")</div>
                </div>
                <div>
                    <div class="text-muted" style="font-size: 0.82rem;">Cached in</div>
                    <div style="font-size: 1.6rem; font-weight: 600;">
                        @Tokens.Cached(_usage.Totals.CachedInputTokens, _usage.Totals.InputTokens)
                    </div>
                </div>
                <div>
                    <div class="text-muted" style="font-size: 0.82rem;">Tokens out</div>
                    <div style="font-size: 1.6rem; font-weight: 600;">@_usage.Totals.OutputTokens.ToString("N0")</div>
                </div>
            }
            @if (_usage.Totals.Pages > 0)
            {
                <div>
                    <div class="text-muted" style="font-size: 0.82rem;">Pages analysed</div>
                    <div style="font-size: 1.6rem; font-weight: 600;">@_usage.Totals.Pages.ToString("N0")</div>
                </div>
            }
        </div>
    </div>

    @* The two services are billed in units that have nothing to do with each other — tokens
       against pages — so each gets its own section with columns that are true for every row in
       it. A service the proposal never touched is left out rather than shown empty. *@
    @if (_llm.Count > 0 || _llmCalls.Count > 0)
    {
        <h3 class="list-heading">LLM calls</h3>

        <div class="section-title" style="margin-top: 1rem;">By service</div>
        <div class="req-table-wrap">
            <UsageByServiceTable Rows="_llm" Rate="_rate" />
        </div>

        <div class="section-title">
            Call log
            <button class="btn btn-outline btn-sm" style="margin-left: 0.75rem;"
                    @onclick="() => _showLlmCalls = !_showLlmCalls">
                @(_showLlmCalls ? "Hide" : "Show") @CallCount(_llmCalls.Count)
            </button>
        </div>
        @if (_showLlmCalls)
        {
            <div class="req-table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Operation</th>
                            <th>Detail</th>
                            <th>Model</th>
                            <th>User</th>
                            <th style="text-align: right;">Tokens in</th>
                            <th style="text-align: right;">Cached in</th>
                            <th style="text-align: right;">Tokens out</th>
                            <th style="text-align: right;">Cost</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var call in _llmCalls)
                        {
                            <tr class="row-link" @onclick="() => OpenCallAsync(call.Id)">
                                <td class="text-muted">@call.StartedAt.ToLocalTime().ToString("dd MMM HH:mm:ss")</td>
                                <td>@UsageLabels.OperationName(call.Operation)</td>
                                <td class="text-muted">@call.Label</td>
                                <td>@(string.IsNullOrEmpty(call.Model) ? "—" : call.Model)</td>
                                <td class="text-muted">@(call.UserName ?? "System")</td>
                                <td style="text-align: right;">@(call.InputTokens > 0 ? call.InputTokens.ToString("N0") : "—")</td>
                                <td style="text-align: right;">@Tokens.Cached(call.CachedInputTokens, call.InputTokens)</td>
                                <td style="text-align: right;">@(call.OutputTokens > 0 ? call.OutputTokens.ToString("N0") : "—")</td>
                                <td style="text-align: right;">@Cost(call.CostUsd)</td>
                                <td><span class="badge @OutcomeClass(call.Outcome)">@call.Outcome</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @if (_usage.Meters.Count > 0 || _extractionCalls.Count > 0)
    {
        <h3 class="list-heading">Content understanding</h3>

        <div class="section-title" style="margin-top: 1rem;">By service</div>
        <div class="req-table-wrap">
            <UsageByMeterTable Rows="_usage.Meters" Rate="_rate" />
        </div>

        <div class="section-title">
            Call log
            <button class="btn btn-outline btn-sm" style="margin-left: 0.75rem;"
                    @onclick="() => _showExtractionCalls = !_showExtractionCalls">
                @(_showExtractionCalls ? "Hide" : "Show") @CallCount(_extractionCalls.Count)
            </button>
        </div>
        @if (_showExtractionCalls)
        {
            <div class="req-table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>When</th>
                            <th>Operation</th>
                            <th>Detail</th>
                            <th>Analyzer</th>
                            <th>User</th>
                            <th>Meter</th>
                            <th style="text-align: right;">Pages</th>
                            <th style="text-align: right;">Cost</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var call in _extractionCalls)
                        {
                            <tr class="row-link" @onclick="() => OpenCallAsync(call.Id)">
                                <td class="text-muted">@call.StartedAt.ToLocalTime().ToString("dd MMM HH:mm:ss")</td>
                                <td>@UsageLabels.OperationName(call.Operation)</td>
                                <td class="text-muted">@call.Label</td>
                                <td>@call.Model</td>
                                <td class="text-muted">@(call.UserName ?? "System")</td>
                                <td class="text-muted">@(call.Meter ?? "—")</td>
                                <td style="text-align: right;">@(call.Pages is > 0 ? call.Pages.Value.ToString("N0") : "—")</td>
                                <td style="text-align: right;">@Cost(call.CostUsd)</td>
                                <td><span class="badge @OutcomeClass(call.Outcome)">@call.Outcome</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@if (_detail is not null)
{
    <div class="modal-backdrop" @onclick="() => _detail = null">
        <div class="modal-panel modal-wide" @onclick:stopPropagation>
            <h2 class="modal-title">@UsageLabels.OperationName(_detail.Call.Operation) — @_detail.Call.Model</h2>
            <p class="text-muted" style="margin-top: -0.5rem;">
                @_detail.Call.StartedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss") ·
                @(_detail.Call.UserName ?? "System") ·
                @_detail.Call.Duration.TotalSeconds.ToString("N1") s ·
                @Cost(_detail.Call.CostUsd)
                @* An extraction call has no tokens to have cached, so the fragment is left out
                   rather than printed as a dash. *@
                @if (_detail.Call.InputTokens > 0)
                {
                    <text> · @Tokens.Cached(_detail.Call.CachedInputTokens, _detail.Call.InputTokens) cached</text>
                }
                @if (_detail.Call.Label is not null)
                {
                    <text> · @_detail.Call.Label</text>
                }
            </p>

            @if (_detail.Call.ErrorMessage is not null)
            {
                <div class="section-title">Error</div>
                <div class="preview-text">@_detail.Call.ErrorMessage</div>
            }
            @if (_detail.InstructionText is not null)
            {
                <div class="section-title">Instruction</div>
                <div class="preview-text">@_detail.InstructionText</div>
            }

            <div class="section-title">Request</div>
            <div class="preview-text">@(_detail.RequestText ?? "(not captured)")</div>

            <div class="section-title">Response</div>
            <div class="preview-text">@(_detail.ResponseText ?? "(not captured)")</div>

            <div class="modal-actions">
                <button class="btn btn-outline" @onclick="() => _detail = null">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProposalId { get; set; }

    private ProposalUsage? _usage;
    private List<AiUsageBreakdownRow> _llm = [];
    private List<AiUsageCall> _llmCalls = [];
    private List<AiUsageCall> _extractionCalls = [];
    private AiUsageCallDetail? _detail;
    private decimal _rate;
    private bool _loading = true;
    private bool _showLlmCalls;
    private bool _showExtractionCalls;
    private string? _error;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var user = await CurrentUser.GetAsync();
            _rate = Usage.UsdToDkk;
            _usage = await Usage.GetProposalUsageAsync(ProposalId, user.Id);
            var calls = await Usage.GetProposalCallsAsync(ProposalId, user.Id);

            // Splitting the one query's result rather than querying twice: which section a call
            // belongs in is a display question, and the log is already loaded whole.
            // A figure description is a vision LLM call, so it lands with the tokens it cost even
            // though it came out of the extraction pipeline; its OperationId ties it back.
            _llm = _usage.Breakdown
                .Where(b => b.Service != AiServiceKind.ContentUnderstanding).ToList();
            _llmCalls = calls
                .Where(c => c.Service != AiServiceKind.ContentUnderstanding).ToList();
            _extractionCalls = calls
                .Where(c => c.Service == AiServiceKind.ContentUnderstanding).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCallAsync(Guid recordId)
    {
        var user = await CurrentUser.GetAsync();
        _detail = await Usage.GetCallDetailAsync(recordId, user.Id);
    }

    private string Cost(decimal usd) => Money.Display(usd, _rate);

    /// <summary>Splitting the log by service makes a one-call section common; "1 calls" is not.</summary>
    private static string CallCount(int calls) => calls == 1 ? "1 call" : $"{calls:N0} calls";

    private static string OutcomeClass(GenerationOutcome outcome) => outcome switch
    {
        GenerationOutcome.Succeeded => "badge-ok",
        GenerationOutcome.Failed => "badge-missing",
        _ => "badge-stale",
    };
}
