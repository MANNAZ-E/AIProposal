@* The bid team's thread list. One flat list, unlike the AI chat list beside it: every thread
   belongs to the whole team, so there is no "is this mine" question for groups to answer. *@

<div class="chat-list">
    <div class="chat-list-header">
        <span class="chat-list-title">Bid Team Chat</span>
    </div>

    @* The first row is the unstarted chat: it is both the button you press and the row you
       stand on while writing, so the two stop being separate things in separate places. *@
    <div class="chat-row-wrap chat-new-wrap">
        <button class="chat-row chat-new-row @(IsDraftActive ? "active" : null)" type="button"
                @onclick="StartNewAsync">
            <span class="chat-row-line">
                <span class="chat-row-title">＋ New chat</span>
            </span>
        </button>
    </div>

    @foreach (var thread in Threads)
    {
        @Row(thread)
    }
</div>

@code {
    [Parameter, EditorRequired] public List<TeamThreadListItem> Threads { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public bool IsDraftActive { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback<(Guid Id, string Title)> OnRename { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }

    private Guid? _menuFor;
    private Guid? _renameFor;
    private Guid? _deleteFor;
    private string _renameText = "";
    private ElementReference _renameInput;
    private bool _focusRename;

    /// <summary>
    /// Pressing the row you are already standing on would reset the draft's material picker,
    /// so an active draft swallows the click rather than starting over.
    /// </summary>
    private Task StartNewAsync() => IsDraftActive ? Task.CompletedTask : OnNew.InvokeAsync();

    private RenderFragment Row(TeamThreadListItem thread) =>
        @<div class="chat-row-wrap">
            @if (_renameFor == thread.Id)
            {
                <div class="chat-row chat-row-editing">
                    <input class="chat-rename-input" @ref="_renameInput" value="@_renameText" @oninput="OnRenameInput"
                           @onkeydown="e => OnRenameKey(e, thread)" @onblur="() => OnRenameBlur(thread)" />
                </div>
            }
            else if (_deleteFor == thread.Id)
            {
                @* Confirming in the row itself: a chat is cheap, and a modal for each one would
                   be heavier than the thing it is protecting. It still says who else loses it,
                   because every chat here belongs to the whole team. *@
                <div class="chat-row chat-row-editing">
                    <div class="chat-row-meta">Delete this chat? The team loses it too.</div>
                    <div class="chat-row-actions">
                        <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteAsync(thread)">Delete</button>
                        <button class="btn btn-outline btn-sm" @onclick="() => _deleteFor = null">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <button class="chat-row @(SelectedId == thread.Id ? "active" : null)" type="button"
                        @onclick="() => OnSelect.InvokeAsync(thread.Id)"
                        @ondblclick="() => TryStartRename(thread)">
                    <span class="chat-row-line">
                        <span class="chat-row-title @(thread.HasUnread ? "chat-unread" : null)">
                            @if (thread.HasUnread)
                            {
                                <span class="chat-unread-dot" title="New messages">●</span>
                            }
                            @thread.Title
                        </span>
                        <span class="chat-row-time">
                            @RelativeTime.Display(thread.LastMessageAt, DateTimeOffset.UtcNow)
                        </span>
                    </span>
                    @if (thread.CreatedByName is { } name)
                    {
                        <span class="chat-row-meta">Started by @name</span>
                    }
                </button>

                @if (thread.CanRename || thread.CanDelete)
                {
                    <button class="chat-row-menu" title="More" @onclick="() => _menuFor = thread.Id">⋯</button>
                }

                @if (_menuFor == thread.Id)
                {
                    @* No JS interop in this app, so dismissing on an outside click is a
                       transparent full-viewport catcher, the way the modals already work. *@
                    <div class="menu-backdrop" @onclick="() => _menuFor = null"></div>
                    <div class="menu-panel">
                        @if (thread.CanRename)
                        {
                            <button @onclick="() => StartRename(thread)">Rename</button>
                        }
                        @if (thread.CanDelete)
                        {
                            <button @onclick="() => StartDelete(thread)">Delete</button>
                        }
                    </div>
                }
            }
        </div>;

    private void TryStartRename(TeamThreadListItem thread)
    {
        if (thread.CanRename) StartRename(thread);
    }

    private void StartRename(TeamThreadListItem thread)
    {
        _menuFor = null;
        _deleteFor = null;
        _renameText = thread.Title;
        _renameFor = thread.Id;
        _focusRename = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            await _renameInput.FocusAsync();
        }
    }

    private void StartDelete(TeamThreadListItem thread)
    {
        _menuFor = null;
        _renameFor = null;
        _deleteFor = thread.Id;
    }

    private void OnRenameInput(ChangeEventArgs e) => _renameText = (string?)e.Value ?? "";

    private async Task OnRenameKey(KeyboardEventArgs e, TeamThreadListItem thread)
    {
        if (e.Key == "Enter") await CommitRenameAsync(thread);
        else if (e.Key == "Escape") _renameFor = null;
    }

    /// <summary>
    /// Clicking away from the field (another row, "new chat", a different page) ends the
    /// edit without a keypress, so it needs the same save Enter gives it. Escape already
    /// cleared <see cref="_renameFor"/> before any blur reaches here, so this only fires
    /// for an edit that is still actually in progress.
    /// </summary>
    private async Task OnRenameBlur(TeamThreadListItem thread)
    {
        if (_renameFor == thread.Id) await CommitRenameAsync(thread);
    }

    private async Task CommitRenameAsync(TeamThreadListItem thread)
    {
        _renameFor = null;
        if (!string.IsNullOrWhiteSpace(_renameText) && _renameText != thread.Title)
            await OnRename.InvokeAsync((thread.Id, _renameText.Trim()));
    }

    private async Task ConfirmDeleteAsync(TeamThreadListItem thread)
    {
        _deleteFor = null;
        await OnDelete.InvokeAsync(thread.Id);
    }
}
