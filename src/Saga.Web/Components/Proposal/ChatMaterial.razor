@using Saga.Core.Pipeline
@using Saga.Core.Tokenization
@* What a chat is allowed to read. Editable while the chat is a draft, read-only once it has
   started: the selection is frozen so every question re-sends the same prefix and the provider
   can serve it from its cache. *@

<div class="chat-material">
    @if (ReadOnly)
    {
        @* Above the list, not under it: the list is long enough to scroll the reason it cannot
           be touched off the screen. *@
        <div class="chat-material-locked">
            <div class="chat-material-locked-head">Materials locked</div>
            <p class="form-hint">
                Materials are locked when a chat is started — start a
                <button class="link-button" @onclick="OnNewChat">New chat</button> to change
            </p>
        </div>
    }
    else
    {
        <div class="section-title" style="margin-top: 0;">Choose materials</div>
        @if (IsEmpty)
        {
            @* Nothing to pick from is a dead end unless the way out is on screen: the Materials
               tab is a section of this page, not a URL, so it takes a callback rather than a link.
               The presets and the token meter would all read zero here, so they stay off screen. *@
            <p class="form-hint" style="margin-top: 0.35rem;">
                No materials yet — <button class="link-button" @onclick="OnAddMaterials">Go to materials</button>
            </p>
        }
        else
        {
            @* Buttons rather than a radio group: a preset is a shortcut that fills the
               checkboxes below, and the consultant is expected to edit it afterwards — which
               a radio, standing for a choice that holds, would misdescribe. Narrowest preset
               first, and "None" last: it is the way out of the row rather than the narrowest
               step in it, so it sits past the end instead of in front of the useful ones.
               Editing a checkbox afterwards only unlights the button it moved away from;
               naming the result adds nothing the boxes do not already show. *@
            <div class="chat-material-presets">
                @foreach (var preset in Presets)
                {
                    <button type="button" class="chat-preset @(IsPresetActive(preset) ? "active" : "")"
                            disabled="@IsPresetDisabled(preset)"
                            @onclick="() => ApplyPreset(preset)">@ContextLabel(preset)</button>
                }
                <button type="button" class="chat-preset @(NothingSelected ? "active" : "")"
                        @onclick="ClearSelection">None</button>
            </div>
        }
    }

    @foreach (var category in Categories)
    {
        @Group(category.Key, category.ToList())
    }

    @if (Artifacts.Count > 0)
    {
        <div class="chat-material-group">
            <label class="chat-material-head">
                <input type="checkbox" disabled="@ReadOnly"
                       checked="@Artifacts.All(a => SelectedArtifacts.Contains(a.Type))"
                       @onchange="e => ToggleAllArtifacts((bool?)e.Value == true)" />
                <span>Proposal artifacts (@Artifacts.Count(a => SelectedArtifacts.Contains(a.Type)))</span>
            </label>
            <div class="chat-material-items">
                @foreach (var artifact in Artifacts)
                {
                    <label class="chat-material-item">
                        <input type="checkbox" disabled="@ReadOnly"
                               checked="@SelectedArtifacts.Contains(artifact.Type)"
                               @onchange="() => ToggleArtifact(artifact.Type)" />
                        <span>@ArtifactLabel(artifact.Type)</span>
                    </label>
                }
            </div>
        </div>
    }

    @if (!ReadOnly && !IsEmpty)
    {
        <div class="chat-token-meter">
            @SelectedTokens.ToString("N0") tokens
            @if (SelectedTokens > Budget)
            {
                <span class="text-muted">· over budget, documents will be condensed</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<Document> Documents { get; set; } = [];
    [Parameter, EditorRequired] public List<Artifact> Artifacts { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<Guid> SelectedDocuments { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<ArtifactType> SelectedArtifacts { get; set; } = [];
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public int Budget { get; set; } = 100_000;
    [Parameter] public WorkingContextKind Preset { get; set; }
    [Parameter] public EventCallback<WorkingContextKind> PresetChanged { get; set; }

    /// <summary>Opens the Materials tab when there is nothing here to choose from.</summary>
    [Parameter] public EventCallback OnAddMaterials { get; set; }

    /// <summary>Starts a fresh chat from this one's material — the only way to change a frozen selection.</summary>
    [Parameter] public EventCallback OnNewChat { get; set; }

    /// <summary>Narrowest first — "Client materials" reads before the wider presets.</summary>
    private static readonly WorkingContextKind[] Presets = MaterialSelection.ChatPresets;

    /// <summary>Nothing to read: every preset would be greyed out and every count zero.</summary>
    private bool IsEmpty => Documents.Count == 0 && Artifacts.Count == 0;

    /// <summary>What "None" leaves behind. No preset selects nothing — one that would is
    /// greyed out — so an empty selection is the "None" button's alone to light up.</summary>
    private bool NothingSelected => SelectedDocuments.Count == 0 && SelectedArtifacts.Count == 0;

    private bool IsPresetActive(WorkingContextKind kind) => Preset == kind && !NothingSelected;

    private bool IsPresetDisabled(WorkingContextKind kind)
        => !MaterialSelection.IsPresetAvailable(kind, Documents, Artifacts);

    /// <summary>
    /// The proposal's own document types, in their priority order — the same grouping the
    /// Materials tab shows and the same one the model is handed the material under.
    /// </summary>
    private IEnumerable<IGrouping<string, Document>> Categories
        => Documents
            .GroupBy(d => d.DocumentType?.Name ?? "Material")
            .OrderBy(g => g.Min(d => d.DocumentType?.SortOrder ?? int.MaxValue))
            .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// What the selection costs the context, in the same tokens the Materials tab shows per
    /// document. Documents carry a stored count; artifacts are small and counted on the spot.
    /// </summary>
    private int SelectedTokens
        => Documents.Where(d => SelectedDocuments.Contains(d.Id))
               .Sum(TokenBudget.TokensOf)
           + Artifacts.Where(a => SelectedArtifacts.Contains(a.Type))
               .Sum(a => TokenCounter.Count(a.ContentMarkdown ?? a.ContentJson));

    private bool IsDocumentChecked(Document document) => SelectedDocuments.Contains(document.Id);

    private async Task ToggleDocument(Document document)
    {
        if (ReadOnly) return;
        if (!SelectedDocuments.Add(document.Id)) SelectedDocuments.Remove(document.Id);
        await MarkCustomAsync();
    }

    private async Task ToggleAllDocuments(List<Document> documents, bool on)
    {
        if (ReadOnly) return;
        foreach (var document in documents)
        {
            if (on) SelectedDocuments.Add(document.Id);
            else SelectedDocuments.Remove(document.Id);
        }
        await MarkCustomAsync();
    }

    private async Task ToggleArtifact(ArtifactType type)
    {
        if (ReadOnly) return;
        if (!SelectedArtifacts.Add(type)) SelectedArtifacts.Remove(type);
        await MarkCustomAsync();
    }

    private async Task ToggleAllArtifacts(bool on)
    {
        if (ReadOnly) return;
        foreach (var artifact in Artifacts)
        {
            if (on) SelectedArtifacts.Add(artifact.Type);
            else SelectedArtifacts.Remove(artifact.Type);
        }
        await MarkCustomAsync();
    }

    /// <summary>Clears the lot, so a selection can be built up from nothing instead of pared down.</summary>
    private async Task ClearSelection()
    {
        if (ReadOnly) return;
        SelectedDocuments.Clear();
        SelectedArtifacts.Clear();
        await MarkCustomAsync();
    }

    /// <summary>Touching a checkbox means the selection is no longer one of the presets.</summary>
    private async Task MarkCustomAsync()
    {
        var selection = new MaterialSelection(SelectedDocuments.ToList(), SelectedArtifacts.ToList());
        await PresetChanged.InvokeAsync(selection.PresetOrCustom(Documents, Artifacts));
    }

    private async Task ApplyPreset(WorkingContextKind preset)
    {
        var selection = MaterialSelection.ForPreset(preset, Documents, Artifacts);
        SelectedDocuments.Clear();
        foreach (var id in selection.DocumentIds) SelectedDocuments.Add(id);
        SelectedArtifacts.Clear();
        foreach (var type in selection.ArtifactTypes) SelectedArtifacts.Add(type);
        await PresetChanged.InvokeAsync(preset);
    }

    private RenderFragment? Group(string title, List<Document> documents)
    {
        if (documents.Count == 0) return null;
        return @<div class="chat-material-group">
            <label class="chat-material-head">
                <input type="checkbox" disabled="@ReadOnly" checked="@documents.All(IsDocumentChecked)"
                       @onchange="e => ToggleAllDocuments(documents, (bool?)e.Value == true)" />
                <span>@title (@documents.Count(IsDocumentChecked))</span>
            </label>
            <div class="chat-material-items">
                @foreach (var document in documents)
                {
                    <label class="chat-material-item">
                        <input type="checkbox" disabled="@ReadOnly" checked="@IsDocumentChecked(document)"
                               @onchange="() => ToggleDocument(document)" />
                        <span>@document.Name</span>
                    </label>
                }
            </div>
        </div>;
    }

    /// <summary>
    /// What a chat's material selection is called — on the preset buttons here and on the header
    /// of a chat that already froze one, so both name the same thing.
    /// </summary>
    public static string ContextLabel(WorkingContextKind kind) => kind switch
    {
        WorkingContextKind.ClientMaterial => "Client materials",
        WorkingContextKind.SourceMaterial => "All materials",
        WorkingContextKind.Analysis => "Analysis",
        WorkingContextKind.Custom => "Selected material",
        _ => "All materials and proposal content",
    };

    public static string ArtifactLabel(ArtifactType type) => type switch
    {
        ArtifactType.ClientProfile => "Client profile",
        ArtifactType.SolutionProposal => "Solution",
        _ => type.ToString(),
    };
}
