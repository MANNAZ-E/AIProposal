{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Saga": "Server=(localdb)\\mssqllocaldb;Database=Saga;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Auth": {
    "DevAutoSignIn": true,
    "DevUserEmail": "elv@mannaz.com"
  },
  "Storage": {
    "LocalPath": ""
  },
  "ContentUnderstanding": {
    "Endpoint": "https://mannazaiproposal.services.ai.azure.com/"
  },
  // Dev now calls the real Foundry deployments, so every generation costs money. Flip UseFakeAi
  // back to true for the offline stand-in — it wins even with the endpoint below configured, and
  // is the escape hatch for exercising the UI without spending tokens. Same for UseFakeExtractor
  // and the Content Understanding endpoint above.
  "Ai": {
    "UseFakeAi": false,
    "UseFakeExtractor": false
  },
  // The Azure OpenAI alias of the same MannazAIProposal resource ContentUnderstanding uses; the
  // services.ai.azure.com form above is not the one AzureOpenAIClient wants. Key stays empty —
  // locally the app authenticates as the az login / Visual Studio user.
  "AzureOpenAI": {
    "Endpoint": "https://mannazaiproposal.openai.azure.com/",
    "Key": "",
    "StrongDeployment": "gpt-5.6-luna",
    "LightDeployment": "gpt-5.6-luna"
  },
  "Pricing": {
    "UsdToDkk": 6.9,
    // fake-model is priced so local usage numbers are non-zero; the two real deployments carry
    // the same rates as production, for whenever dev is pointed at a real endpoint.
    "Models": {
      "fake-model": { "InputPer1M": 1.25, "OutputPer1M": 10.0 },
      "gpt-5.6-terra": { "InputPer1M": 4.40, "CachedInputPer1M": 0.44, "OutputPer1M": 26.40 },
      "gpt-5.6-luna": { "InputPer1M": 1.10, "CachedInputPer1M": 0.11, "OutputPer1M": 6.60 }
    },
    // USD per 1,000 units, from Microsoft's retail price feed for West Europe (checked
    // 2026-08-24). Keyed by METER, not by analyzer: Content Understanding charges for the work it
    // actually performed, so prebuilt-layout bills Minimal on a digital Office file and Standard on
    // a PDF, an image, or a screenshot lifted out of a .docx — a 500x difference on the same call.
    "ContentUnderstanding": {
      "DocumentPagesMinimalPer1000": 0.01,
      "DocumentPagesBasicPer1000": 1.00,
      "DocumentPagesStandardPer1000": 5.00,
      // Pure content extraction produces none; only a generative analyzer would.
      "ContextualizationTokensPer1000": 0.001
    }
  }
}
